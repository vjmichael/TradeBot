+++ b/tests/test_review_events.py
@@ -0,0 +1,28 @@
+import ctypes
+import unittest
+from unittest.mock import Mock,patch
+from reserve_checkpoint import CheckpointError
+from reserve_review_events import SessionEvents
+
+
+class EventLatchTests(unittest.TestCase):
+    def make(self,results=(0,),open_state=1):
+        ev=SessionEvents.__new__(SessionEvents)
+        ev.bus=ctypes.c_void_p(1);ev.slots=[];ev.invalid=False;ev.lib=Mock()
+        ev.lib.sd_bus_is_open.return_value=open_state
+        ev.lib.sd_bus_process.side_effect=results
+        return ev
+    def test_signal_is_permanent_even_after_return_to_session(self):
+        ev=self.make();ev.check();ev._invalidate(None,None,None)
+        for _ in range(2):
+            with self.assertRaises(CheckpointError):ev.check()
+    def test_bus_failure_and_backlog_permanently_fail_closed(self):
+        for results,reason in (((-1,),'invalidated'),((1,)*128,'backlog')):
+            with self.subTest(reason=reason):
+                ev=self.make(results)
+                with self.assertRaisesRegex(CheckpointError,reason):ev.check()
+                self.assertTrue(ev.invalid)
+                with self.assertRaises(CheckpointError):ev.check()
+    def test_close_disposes_connection(self):
+        ev=self.make();ev.close();ev.lib.sd_bus_unref.assert_called_once()
+        with self.assertRaises(CheckpointError):ev.check()
