index 0000000..77320d7
--- /dev/null
+++ b/reserve_review_events.py
@@ -0,0 +1,102 @@
+"""Fail-closed logind event latch for one dedicated approval session.
+
+Use the installed libsystemd system-bus client, not a privileged monitor,
+caller-controlled bus address, or polling alone. A loss of session authority
+is irreversible for this review, even if the seat returns before confirmation.
+"""
+import ctypes as c
+from reserve_checkpoint import require
+
+BASE = b'/org/freedesktop/login1/session'
+LOGIN = b'org.freedesktop.login1'
+CALLBACK = c.CFUNCTYPE(c.c_int, c.c_void_p, c.c_void_p, c.c_void_p)
+
+
+class SessionEvents:
+    def __init__(self, session):
+        self.bus = c.c_void_p()
+        self.slots = []
+        self.invalid = False
+        self.lib = c.CDLL('libsystemd.so.0')
+        self.lib.sd_bus_new.argtypes = [c.POINTER(c.c_void_p)]
+        self.lib.sd_bus_new.restype = c.c_int
+        self.lib.sd_bus_set_address.argtypes = [c.c_void_p, c.c_char_p]
+        self.lib.sd_bus_set_address.restype = c.c_int
+        self.lib.sd_bus_set_bus_client.argtypes = [c.c_void_p, c.c_int]
+        self.lib.sd_bus_set_bus_client.restype = c.c_int
+        self.lib.sd_bus_start.argtypes = [c.c_void_p]
+        self.lib.sd_bus_start.restype = c.c_int
+        self.lib.sd_bus_is_open.argtypes = [c.c_void_p]
+        self.lib.sd_bus_is_open.restype = c.c_int
+        self.lib.sd_bus_add_match.argtypes = [c.c_void_p, c.POINTER(c.c_void_p), c.c_char_p, CALLBACK, c.c_void_p]
+        self.lib.sd_bus_add_match.restype = c.c_int
+        self.lib.sd_bus_process.argtypes = [c.c_void_p, c.c_void_p]
+        self.lib.sd_bus_process.restype = c.c_int
+        self.lib.sd_bus_slot_unref.argtypes = [c.c_void_p]
+        self.lib.sd_bus_slot_unref.restype = c.c_void_p
+        self.lib.sd_bus_unref.argtypes = [c.c_void_p]
+        self.lib.sd_bus_unref.restype = c.c_void_p
+        self.lib.sd_bus_path_encode.argtypes = [c.c_char_p, c.c_char_p, c.POINTER(c.c_void_p)]
+        self.lib.sd_bus_path_encode.restype = c.c_int
+        libc = c.CDLL('libc.so.6')
+        libc.free.argtypes = [c.c_void_p]
+        libc.free.restype = None
+        path = c.c_void_p()
+        require(self.lib.sd_bus_path_encode(BASE, session.encode('ascii'), c.byref(path)) >= 0, 'review_session_event_path')
+        try:
+            address = c.string_at(path)
+        finally:
+            libc.free(path)
+        # Keep the callback and slots alive for the entire review.
+        self.callback = CALLBACK(self._invalidate)
+        try:
+            require(self.lib.sd_bus_new(c.byref(self.bus)) >= 0, 'review_session_event_bus')
+            require(self.lib.sd_bus_set_address(self.bus, b'unix:path=/run/dbus/system_bus_socket') >= 0, 'review_session_event_address')
+            require(self.lib.sd_bus_set_bus_client(self.bus, 1) >= 0, 'review_session_event_client')
+            require(self.lib.sd_bus_start(self.bus) >= 0, 'review_session_event_connection')
+            for match in (
+                b"type='signal',sender='" + LOGIN + b"',path='" + address + b"',interface='org.freedesktop.login1.Session',member='Lock'",
+                b"type='signal',sender='" + LOGIN + b"',path='" + address + b"',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'",
+                b"type='signal',sender='org.freedesktop.DBus',interface='org.freedesktop.DBus',member='NameOwnerChanged',arg0='" + LOGIN + b"'",
+            ):
+                slot = c.c_void_p()
+                require(self.lib.sd_bus_add_match(self.bus, c.byref(slot), match, self.callback, None) >= 0, 'review_session_event_subscription')
+                self.slots.append(slot)
+            self.check()
+        except BaseException:
+            self.close()
+            raise
+
+    def _invalidate(self, *_):
+        # On this dedicated seat, any session property change requires fresh
+        # authentication. This is intentionally conservative, including idle
+        # changes, rather than losing a short Active=false/true transition.
+        self.invalid = True
+        return 0
+
+    def check(self):
+        require(bool(self.bus) and not self.invalid and self.lib.sd_bus_is_open(self.bus) > 0, 'review_session_event_invalidated')
+        for _ in range(128):
+            result = self.lib.sd_bus_process(self.bus, None)
+            if result < 0 or self.lib.sd_bus_is_open(self.bus) <= 0:
+                self.invalid = True
+            require(not self.invalid, 'review_session_event_invalidated')
+            if result == 0:
+                return
+        self.invalid = True
+        require(False, 'review_session_event_backlog')
+
+    def close(self):
+        for slot in self.slots:
+            self.lib.sd_bus_slot_unref(slot)
+        self.slots.clear()
+        if self.bus:
+            self.lib.sd_bus_unref(self.bus)
+            self.bus = c.c_void_p()
+        self.invalid = True
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *_):
+        self.close()
