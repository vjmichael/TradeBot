+def cleanup_orphaned_cookie():
+    """Root-owned LightDM cleanup hook; never retire a live login's cookie.
+
+    The normal session owner retires its exact inode in finally. Abrupt X11
+    disconnect/termination can skip finally, so a dedicated-seat manager also
+    calls this after its session exits. An uncertain logind query leaves the
+    cookie untouched (the launcher still denies use without a valid session).
+    """
+    require(os.geteuid() == 0, 'review_display_cleanup_root')
+    uid = pwd.getpwnam('maj-vaj-approval').pw_uid
+    require(uid > 0, 'review_display_cleanup_identity')
+    with protected_dir(launcher.DISPLAY_DIR, uid, 0o700) as directory:
+        fcntl.flock(directory, fcntl.LOCK_EX)
+        try:
+            launcher._cookie(uid)
+        except FileNotFoundError:
+            return False
+        for line in launcher._login('list-sessions', '--no-legend').splitlines():
+            fields = line.split()
+            if len(fields) < 2 or fields[1] != str(uid):
+                continue
+            props = dict(p.split('=', 1) for p in launcher._login('show-session', fields[0], '--property=Class', '--property=State', '--property=User').splitlines() if '=' in p)
+            require(props.get('User') == str(uid) and 'Class' in props and 'State' in props, 'review_cleanup_session_uncertain')
+            # Never interfere with a replacement login, even before it is active.
+            if props['Class'] == 'user' and props['State'] != 'closing':
+                return False
+        os.unlink(launcher.COOKIE.name, dir_fd=directory)
+        os.fsync(directory)
+        return True
+
 def provision():
