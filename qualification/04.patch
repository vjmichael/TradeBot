@@ -0,0 +1,7 @@
+#!/bin/sh
+# LightDM dedicated-seat wrapper. Fixed session only; never run general Xsession
+# hooks that grant additional display access or execute arbitrary shell commands.
+set -eu
+expected=/opt/maj-vaj/scripts/review_session_wrapper.sh
+[ "$#" -eq 1 ] && [ "$1" = "$expected" ] || exit 1
+exec /opt/maj-vaj/venv/bin/python -I -B -c 'import sys;sys.path.insert(0,"/opt/maj-vaj");from reserve_review_session import run;run()'
diff --git a/tests/test_review_session_wrapper.py b/tests/test_review_session_wrapper.py
new file mode 100644
index 0000000..a41473d
--- /dev/null
+++ b/tests/test_review_session_wrapper.py
@@ -0,0 +1,24 @@
+"""The dedicated session must not route arbitrary desktop commands to Xsession."""
+import subprocess
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+WRAPPER = '/opt/maj-vaj/scripts/review_session_wrapper.sh'
+
+
+class DedicatedSessionWrapperTests(unittest.TestCase):
+    def test_rejects_invalid_commands_and_arguments(self):
+        for args in ([], ['/bin/sh'], [WRAPPER, 'extra'], [WRAPPER + ' extra']):
+            with self.subTest(args=args):
+                result = subprocess.run(['/bin/sh', str(ROOT/'scripts/review_session_wrapper.sh'), *args], capture_output=True, timeout=5)
+                self.assertEqual(result.returncode, 1)
+                self.assertEqual(result.stdout, b'')
+
+    def test_dedicated_seat_and_desktop_use_same_fixed_wrapper(self):
+        desktop = (ROOT/'deploy/maj-vaj-approval-session.desktop').read_text().splitlines()
+        seat = (ROOT/'deploy/90-maj-vaj-approval-lightdm.conf.example').read_text().splitlines()
+        self.assertIn('Exec=' + WRAPPER, desktop)
+        self.assertIn('TryExec=' + WRAPPER, desktop)
+        for setting in ('session-wrapper=' + WRAPPER, 'allow-guest=false', 'autologin-user=', 'xserver-allow-tcp=false', 'user-authority-in-system-dir=false'):
+            self.assertIn(setting, seat)
