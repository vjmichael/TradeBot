+import os
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+import reserve_review_launcher as r
+from reserve_checkpoint import CheckpointError
+
+GOOD = dict(User='65533', Active='yes', Remote='no', Type='x11', Class='user',
+            State='active', Display=':12', Seat='seat0', LockedHint='no')
+
+
+class SessionTests(unittest.TestCase):
+    def sessions(self, props=GOOD, listing='3 65533 maj-vaj-approval seat0 tty2'):
+        def call(*args):
+            if args[0] == 'list-sessions':return listing
+            return '\n'.join(f'{k}={v}' for k,v in props.items())
+        return patch.object(r, '_login', side_effect=call)
+    def test_only_local_active_unlocked_dedicated_x11(self):
+        with self.sessions():self.assertEqual(r._sessions(65533), ('3', ':12'))
+        for name, value in [('User','65534'), ('Remote','yes'), ('Active','no'),
+                            ('LockedHint','yes'), ('Type','wayland'), ('Class','greeter'),
+                            ('State','closing'), ('Display','host:12'), ('Seat','')]:
+            with self.subTest(name=name), self.sessions(GOOD | {name:value}):
+                with self.assertRaises(CheckpointError):r._sessions(65533)
+    def test_ambiguous_or_other_user_session_denied(self):
+        for listing in ['3 65534 desk seat0 tty2', '3 65533 approval\n4 65533 approval']:
+            with self.sessions(listing=listing):
+                with self.assertRaises(CheckpointError):r._sessions(65533)
+    def test_fixed_start_no_caller_data(self):
+        with patch.object(r,'session_identity',return_value=('3',':12',(1,2,3,4))), patch.object(r.subprocess,'run') as run, patch.dict(os.environ,{'DISPLAY':'bad:1','XAUTHORITY':'/tmp/untrusted','SYSTEMD_BUS_ADDRESS':'bad'}):
+            r.launch()
+            args,kw=run.call_args
+            self.assertEqual(args[0],['/usr/bin/systemctl','--no-ask-password','--no-block','start',r.UNIT])
+            self.assertEqual(kw['env'],{'PATH':'/usr/bin:/bin','LC_ALL':'C'})
+        with patch.object(r,'session_identity',side_effect=CheckpointError('denied')), patch.object(r.subprocess,'run') as run:
+            with self.assertRaises(CheckpointError):r.launch()
+            run.assert_not_called()
+    def test_wrong_uid_before_any_display_access(self):
+        with patch.object(r.pwd,'getpwnam',return_value=type('User',(),{'pw_uid':65533})()), patch.object(r.os,'geteuid',return_value=65534), patch.object(r,'_sessions') as query:
+            with self.assertRaises(CheckpointError):r.session_identity()
+            query.assert_not_called()
+    def test_serve_pins_display_and_rechecks_before_signing_and_publish(self):
+        first=('3',':12',(1,2,3,4)); changed=('4',':13',(1,2,3,4))
+        def worker(*,role,window):
+            self.assertEqual(role,'review');self.assertEqual(os.environ['DISPLAY'],':12');self.assertEqual(os.environ['XAUTHORITY'],str(r.COOKIE))
+            review=Mock();publish=Mock()
+            window(None,review,{},publish)
+            return publish
+        def widget(root,review,proof,publish,*,guard):
+            guard();publish({'approved':True})
+        with patch.dict(os.environ,{},clear=False), patch.object(r,'session_identity',side_effect=[first,first,first,changed]), patch('reserve_no_effect_worker.main',side_effect=worker), patch('reserve_no_effect_worker.review_window',side_effect=widget):
+            with self.assertRaisesRegex(CheckpointError,'review_session_changed'):r.serve()
+    @unittest.skipUnless(os.geteuid()==0,'actual root-owned parent needed')
+    def test_cookie_custody(self):
+        with tempfile.TemporaryDirectory(dir='/run') as temp:
+            d=Path(temp)/'display';d.mkdir(mode=0o700);os.chown(d,65533,65533)
+            p=d/'Xauthority';p.write_bytes(b'synthetic-test-cookie');os.chown(p,65533,65533);p.chmod(0o600)
+            with patch.object(r,'DISPLAY_DIR',d), patch.object(r,'COOKIE',p):
+                self.assertEqual(r._cookie(65533)[2],p.stat().st_size)
+                p.chmod(0o644)
+                with self.assertRaises(CheckpointError):r._cookie(65533)
+                p.chmod(0o600);os.link(p,d/'extra')
+                with self.assertRaises(CheckpointError):r._cookie(65533)
+                p.unlink();p.symlink_to(d/'extra')
+                with self.assertRaises(OSError):r._cookie(65533)
+
+
+@unittest.skipUnless(os.environ.get('DISPLAY'),'Tk display required')
+class WidgetSessionTests(unittest.TestCase):
+    def test_session_lost_prevents_signing_and_clears_widget(self):
+        # Keep Tk objects off the rest of the suite's worker threads.
+        import subprocess, sys
+        code = """import tkinter as tk
+from unittest.mock import Mock
+from reserve_checkpoint import CheckpointError
+from reserve_no_effect_worker import review_window
+root=tk.Tk()
+try:
+ review=Mock();review.begin.return_value={'display':'Synthetic review','challenge':'TEST'}
+ publish=Mock();guard=Mock(side_effect=CheckpointError('review_session_changed'))
+ ui=review_window(root,review,{},publish,guard=guard);root.update()
+ ui['challenge'].set('TEST');ui['password'].set('synthetic-passphrase');ui['confirm'].invoke();root.update()
+ assert 'Approval refused' in ui['status'].get() and ui['password'].get()==''
+ review.confirm.assert_not_called();publish.assert_not_called()
+finally:root.destroy()
+"""
+        p=subprocess.run([sys.executable,'-B','-c',code],capture_output=True,text=True,timeout=10)
+        self.assertEqual(p.returncode,0,p.stderr)
