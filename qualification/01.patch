@@ -0,0 +1,49 @@
+"""Routing tests, not installed venue or Freqtrade acceptance."""
+import errno
+import unittest
+from unittest.mock import Mock, patch
+from reserve_checkpoint import CheckpointError
+from reserve_native_handoff import snapshot_unavailable
+from reserve_persistent_worker import WarmRuntime
+from reserve_terminal_worker import native_step
+
+ERRORS = [CheckpointError(s) for s in ('snapshot_stale','snapshot_checkpoint_changed','snapshot_changed_during_review')]
+ERRORS.append(FileNotFoundError(errno.ENOENT,'missing','snapshot.bin'))
+BAD = [CheckpointError('snapshot_signature'), CheckpointError('snapshot_scope_or_content_changed'),
+       FileNotFoundError(errno.ENOENT,'missing','checkpoint.json'), FileNotFoundError(errno.ENOENT,'missing','reserve-native.pub'), ValueError('snapshot_stale')]
+
+class SnapshotProtectionTests(unittest.TestCase):
+    def test_classification(self):
+        for exc in ERRORS:self.assertTrue(snapshot_unavailable(exc))
+        for exc in BAD:self.assertFalse(snapshot_unavailable(exc))
+    def test_terminal_only_protected_known_outage_reduces(self):
+        producer=Mock(uid=1000);mail=Mock(owner=1000);mail.read.return_value=None
+        for exc in ERRORS+BAD:
+            with self.subTest(exc=exc), patch('reserve_terminal_worker.os.geteuid',return_value=1000), patch('reserve_terminal_worker.open_reviewed',side_effect=exc), patch('reserve_outage_protection.step',return_value='outage_exit_requested') as reduce:
+                if exc in ERRORS:
+                    self.assertEqual(native_step(producer,None,None,None,1000,mail,protected=True),'outage_exit_requested');reduce.assert_called_once()
+                else:
+                    with self.assertRaises(type(exc)):native_step(producer,None,None,None,1000,mail,protected=True)
+                    reduce.assert_not_called()
+    def test_cold_unprotected_worker_never_falls_back(self):
+        producer=Mock(uid=1000);mail=Mock(owner=1000);mail.read.return_value=None
+        with patch('reserve_terminal_worker.os.geteuid',return_value=1000), patch('reserve_terminal_worker.open_reviewed',side_effect=ERRORS[0]), patch('reserve_outage_protection.step') as reduce:
+            with self.assertRaises(CheckpointError):native_step(producer,None,None,None,1000,mail)
+            reduce.assert_not_called()
+    def test_warm_outage_keeps_driver_and_never_enters_or_retires_pending(self):
+        warm=WarmRuntime(Mock(),None,None);warm._assert_current=Mock();warm.driver=object();driver=warm.driver
+        mail=Mock()
+        for exc in ERRORS:
+            for pending in (None,{'receipt':'pending'}):
+                mail.read.return_value=pending
+                with patch('reserve_persistent_worker.native_step',side_effect=exc), patch('reserve_persistent_worker.native_once') as enter, patch('reserve_outage_protection.step',return_value='outage_exit_requested') as reduce, patch.object(warm,'refresh_wallet') as wallet:
+                    self.assertEqual(warm.cycle(None,None,1000,mail,None,None),'snapshot_held' if pending else 'outage_exit_requested')
+                    self.assertIs(warm.driver,driver);enter.assert_not_called();wallet.assert_not_called()
+                    if pending:reduce.assert_not_called()
+                    else:reduce.assert_called_once()
+    def test_unclassified_error_not_swallowed_by_warm_loop(self):
+        warm=WarmRuntime(Mock(),None,None);warm._assert_current=Mock()
+        for exc in BAD:
+            with patch('reserve_persistent_worker.native_step',side_effect=exc), patch('reserve_outage_protection.step') as reduce, patch('reserve_persistent_worker.native_once') as enter:
+                with self.assertRaises(type(exc)):warm.cycle(None,None,1000,Mock(),None,None)
+                reduce.assert_not_called();enter.assert_not_called()
