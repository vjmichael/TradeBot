diff --git a/reserve_review_launcher.py b/reserve_review_launcher.py
new file mode 100644
index 0000000..9b93c0c
--- /dev/null
+++ b/reserve_review_launcher.py
@@ -0,0 +1,108 @@
+"""Local dedicated approval-session launcher. No desk RPC or approval credentials.
+
+The administrator owns the display/session provisioning; no caller supplied
+DISPLAY, XAUTHORITY, command, service name or recovery action is accepted.
+"""
+import os
+import pwd
+import re
+import stat
+import subprocess
+import sys
+from pathlib import Path
+from reserve_checkpoint import require
+from reserve_ipc import protected_dir
+
+UNIT = 'maj-vaj-reviewed-recovery-review.service'
+DISPLAY_DIR = Path('/run/maj-vaj-review-display')
+COOKIE = DISPLAY_DIR / 'Xauthority'
+MARKER = Path('/etc/maj-vaj/review-desktop-enabled')
+PROPERTIES = ('User', 'Active', 'Remote', 'Type', 'Class', 'State', 'Display', 'Seat', 'LockedHint')
+
+
+def _login(*args):
+    return subprocess.run(['/usr/bin/loginctl', '--no-pager', *args], check=True,
+                          stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
+                          text=True, timeout=3, env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'}).stdout
+
+
+def _sessions(uid):
+    """Use logind's trusted session metadata, never caller environment."""
+    matches = []
+    for line in _login('list-sessions', '--no-legend').splitlines():
+        fields = line.split()
+        if len(fields) < 2 or fields[1] != str(uid):
+            continue
+        session = fields[0]
+        require(re.fullmatch(r'[A-Za-z0-9_-]{1,64}', session) is not None, 'review_session_id')
+        output = _login('show-session', session, *[f'--property={p}' for p in PROPERTIES])
+        props = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
+        if (props.get('User'), props.get('Active'), props.get('Remote'), props.get('Type'), props.get('Class'), props.get('State'), props.get('LockedHint')) != (str(uid), 'yes', 'no', 'x11', 'user', 'active', 'no'):
+            continue
+        display = props.get('Display', '')
+        if re.fullmatch(r':[0-9]{1,4}(?:\.0)?', display) and re.fullmatch(r'seat[A-Za-z0-9_-]{1,60}', props.get('Seat', '')):
+            matches.append((session, display))
+    require(len(matches) == 1, 'review_local_session_required')
+    return matches[0]
+
+
+def _cookie(uid):
+    with protected_dir(DISPLAY_DIR, uid, 0o700) as fd:
+        f = os.open(COOKIE.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=fd)
+        try:
+            st = os.fstat(f)
+            require(stat.S_ISREG(st.st_mode) and st.st_uid == uid and st.st_nlink == 1 and
+                    stat.S_IMODE(st.st_mode) == 0o600 and 0 < st.st_size <= 65536, 'review_display_cookie')
+            return (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
+        finally:
+            os.close(f)
+
+
+def session_identity():
+    uid = pwd.getpwnam('maj-vaj-approval').pw_uid
+    require(uid > 0 and os.geteuid() == uid, 'review_authority_session_only')
+    with protected_dir(MARKER.parent, 0, 0o755) as fd:
+        f = os.open(MARKER.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK, dir_fd=fd)
+        try:
+            s = os.fstat(f)
+            require(stat.S_ISREG(s.st_mode) and s.st_uid == 0 and s.st_nlink == 1 and not s.st_mode & 0o022, 'review_desktop_disabled')
+        finally:
+            os.close(f)
+    try:
+        return (*_sessions(uid), _cookie(uid))
+    except (OSError, subprocess.SubprocessError) as exc:
+        raise ValueError('review_session_unavailable') from exc
+
+
+def launch():
+    session_identity()
+    subprocess.run(['/usr/bin/systemctl', '--no-ask-password', '--no-block', 'start', UNIT],
+                   check=True, timeout=5, env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'})
+
+
+def serve():
+    identity = session_identity()
+    os.environ['DISPLAY'] = identity[1]
+    os.environ['XAUTHORITY'] = str(COOKIE)
+    from reserve_no_effect_worker import main, review_window
+    def guard():
+        require(session_identity() == identity, 'review_session_changed')
+    def window(root, review, proof, publish):
+        guard()
+        def checked_publish(approved):
+            guard()
+            publish(approved)
+        return review_window(root, review, proof, checked_publish, guard=guard)
+    main(role='review', window=window)
+
+
+def main():
+    require(len(sys.argv) == 2 and sys.argv[1] in ('launch', 'serve'), 'review_launcher_usage')
+    (launch if sys.argv[1] == 'launch' else serve)()
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except Exception:
+        raise SystemExit('PAPER approval unavailable. Use the dedicated local approval session.') from None
