index 0000000..c89611b
--- /dev/null
+++ b/reserve_review_session.py
@@ -0,0 +1,158 @@
+"""Dedicated local X11 login session; no signing, desk access or auto approval.
+
+The display manager must be administrator configured to create a private
+.Xauthority in the approval account's home, for a real local login. A single
+matching local cookie is exported to the service's existing private runtime
+path, never printed or passed as a command argument.
+"""
+import fcntl
+import os
+import pwd
+import secrets
+import socket
+import stat
+import struct
+import subprocess
+from pathlib import Path
+
+import reserve_review_launcher as launcher
+from reserve_checkpoint import require
+from reserve_ipc import protected_dir
+
+MAX = 65536
+
+
+def select_cookie(data, display, host):
+    """Strict, bounded Xauthority parser; no wildcard/remote records exported."""
+    require(0 < len(data) <= MAX, 'review_xauthority_size')
+    number = display.split('.', 1)[0].removeprefix(':').encode('ascii')
+    pos, found = 0, []
+    while pos < len(data):
+        start = pos
+        require(pos + 2 <= len(data), 'review_xauthority_format')
+        family = struct.unpack_from('!H', data, pos)[0]
+        pos += 2
+        fields = []
+        for _ in range(4):
+            require(pos + 2 <= len(data), 'review_xauthority_format')
+            size = struct.unpack_from('!H', data, pos)[0]
+            pos += 2
+            require(pos + size <= len(data), 'review_xauthority_format')
+            fields.append(data[pos:pos + size])
+            pos += size
+        address, display_number, name, value = fields
+        if (family, address, display_number, name) == (256, host, number, b'MIT-MAGIC-COOKIE-1'):
+            require(len(value) == 16, 'review_xauthority_cookie')
+            found.append(data[start:pos])
+    require(len(found) == 1, 'review_xauthority_unique_local_cookie')
+    return found[0]
+
+
+def read_source(home, uid):
+    with protected_dir(home, uid, 0o700) as directory:
+        fd = os.open('.Xauthority', os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
+        with os.fdopen(fd, 'rb') as source:
+            before = os.fstat(source.fileno())
+            require(stat.S_ISREG(before.st_mode) and before.st_uid == uid and
+                    before.st_nlink == 1 and stat.S_IMODE(before.st_mode) == 0o600 and
+                    0 < before.st_size <= MAX, 'review_xauthority_custody')
+            data = source.read(MAX + 1)
+            after = os.fstat(source.fileno())
+            require((before.st_size, before.st_mtime_ns, before.st_ctime_ns) ==
+                    (after.st_size, after.st_mtime_ns, after.st_ctime_ns) and len(data) == before.st_size,
+                    'review_xauthority_changed')
+            return data
+
+
+def install_cookie(uid, data, check):
+    with protected_dir(launcher.DISPLAY_DIR, uid, 0o700) as directory:
+        fcntl.flock(directory, fcntl.LOCK_EX)
+        name = '.cookie-' + secrets.token_hex(16)
+        try:
+            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
+                         0o600, dir_fd=directory)
+            with os.fdopen(fd, 'wb') as out:
+                out.write(data)
+                out.flush()
+                os.fsync(out.fileno())
+            check()
+            os.replace(name, launcher.COOKIE.name, src_dir_fd=directory, dst_dir_fd=directory)
+            os.fsync(directory)
+        finally:
+            try:
+                os.unlink(name, dir_fd=directory)
+            except FileNotFoundError:
+                pass
+        return launcher._cookie(uid)
+
+
+def retire_cookie(uid, identity):
+    # Do not retire a replacement login's cookie.
+    with protected_dir(launcher.DISPLAY_DIR, uid, 0o700) as directory:
+        fcntl.flock(directory, fcntl.LOCK_EX)
+        try:
+            if launcher._cookie(uid) == identity:
+                os.unlink(launcher.COOKIE.name, dir_fd=directory)
+                os.fsync(directory)
+        except FileNotFoundError:
+            pass
+
+
+def provision():
+    uid = launcher.authority_uid()
+    session, display = launcher._sessions(uid)
+    launcher.caller_session(session)
+    home = Path(pwd.getpwuid(uid).pw_dir)
+    require(home.is_absolute() and home != Path('/'), 'review_approval_home')
+    # The environment is only a consistency check, never the source of authority.
+    require(os.environ.get('DISPLAY') == display and
+            os.environ.get('XAUTHORITY', str(home / '.Xauthority')) == str(home / '.Xauthority'),
+            'review_display_manager_contract')
+    data = select_cookie(read_source(home, uid), display, socket.gethostname().encode())
+    def check():
+        require(launcher._sessions(uid) == (session, display), 'review_session_changed')
+        launcher.caller_session(session)
+    identity = install_cookie(uid, data, check)
+    try:
+        check()
+        launcher.verify_display(display)
+        require(launcher.session_identity() == (session, display, identity), 'review_session_changed')
+    except BaseException:
+        retire_cookie(uid, identity)
+        raise
+    return uid, session, display, identity
+
+
+def run():
+    uid, session, display, identity = provision()
+    try:
+        os.environ['DISPLAY'] = display
+        os.environ['XAUTHORITY'] = str(launcher.COOKIE)
+        import tkinter as tk
+        from tkinter import ttk
+        root = tk.Tk()
+        root.title('Maj Vaj — PAPER approval session')
+        root.geometry('560x240+30+30')
+        ttk.Label(root, text='PAPER recovery approval', font=('TkDefaultFont', 16)).pack(pady=16)
+        ttk.Label(root, text='Review interrupted orders only. Trading stays paused.', wraplength=500).pack(pady=8)
+        status = tk.StringVar(value='No approval requested.')
+        def start():
+            try:
+                require(launcher.session_identity() == (session, display, identity), 'review_session_changed')
+                launcher.launch()
+                status.set('Review requested. No reservation released by this launcher.')
+            except (ValueError, OSError, subprocess.SubprocessError):
+                status.set('Review unavailable. No approval recorded.')
+        ttk.Button(root, text='Review interrupted PAPER order', command=start).pack(pady=8)
+        ttk.Label(root, textvariable=status, wraplength=500).pack(pady=8)
+        ttk.Button(root, text='End approval session', command=root.destroy).pack(pady=8)
+        root.mainloop()
+    finally:
+        retire_cookie(uid, identity)
+
+
+if __name__ == '__main__':
+    try:
+        run()
+    except Exception:
+        raise SystemExit('Dedicated PAPER approval session unavailable.') from None
