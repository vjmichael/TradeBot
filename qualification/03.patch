@@ -0,0 +1,51 @@
+#!/bin/bash
+# Explicit administrator operation. No downloads, login changes, autologin,
+# seat switching, key access, activation markers, or service start.
+set -euo pipefail
+[[ $# == 1 && ( $1 == --check || $1 == --install ) ]] || { echo 'Usage: provision_review_desktop.sh --check|--install' >&2; exit 2; }
+[[ $EUID == 0 && $(cat /proc/1/comm) == systemd ]] || { echo 'A root-reviewed systemd installation is required.' >&2; exit 1; }
+cd /opt/maj-vaj
+bad=0
+for p in polkitd lightdm lightdm-gtk-greeter xserver-xorg-core xserver-xorg-input-libinput xauth x11-xserver-utils libpam-systemd dbus-user-session; do
+  if [[ $(dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null || :) != 'ii ' ]]; then
+    printf 'Missing installed package: %s\n' "$p" >&2; bad=1
+  fi
+done
+for f in /usr/bin/loginctl /usr/bin/systemctl /usr/bin/xhost /usr/sbin/lightdm /usr/lib/xorg/Xorg /opt/maj-vaj/venv/bin/python; do
+  if [[ ! -x $f ]]; then printf 'Missing executable: %s\n' "$f" >&2; bad=1; fi
+done
+((bad == 0)) || exit 1
+venv/bin/python -I -B - <<'PY'
+import os,pwd,grp,stat
+from pathlib import Path
+import tkinter
+for name in ('maj-vaj','maj-vaj-native','maj-vaj-approval'):
+    p=pwd.getpwnam(name)
+    assert p.pw_uid>0 and p.pw_gid==grp.getgrnam(name).gr_gid
+p=pwd.getpwnam('maj-vaj-approval')
+assert len({pwd.getpwnam(n).pw_uid for n in ('maj-vaj','maj-vaj-native','maj-vaj-approval')})==3
+home=Path(p.pw_dir); st=home.lstat()
+assert home.is_absolute() and stat.S_ISDIR(st.st_mode) and st.st_uid==p.pw_uid and stat.S_IMODE(st.st_mode)==0o700
+assert p.pw_shell not in ('/usr/sbin/nologin','/sbin/nologin','/bin/false') and os.access(p.pw_shell,os.X_OK)
+for name in ('reserve_review_launcher.py','reserve_review_session.py','reserve_no_effect_worker.py','deploy'):
+    st=Path(name).lstat();assert st.st_uid==0 and not st.st_mode&0o022 and not stat.S_ISLNK(st.st_mode)
+print('Approval identity, private home, and code custody preflight passed.')
+PY
+[[ $1 == --install ]] || exit 0
+# Do not overwrite a differing administrator configuration. Install only fixed artifacts.
+install_fixed(){
+ local source=$1 dest=$2
+ if [[ -e $dest || -L $dest ]]; then
+   [[ ! -L $dest && -f $dest && $(stat -c '%u:%a' "$dest") == 0:644 ]] && cmp -s "$source" "$dest" || { echo "Administrator reconciliation required: $dest" >&2; exit 1; }
+ else
+   install -o root -g root -m 644 "$source" "$dest"
+ fi
+}
+install_fixed deploy/maj-vaj-reviewed-recovery-review.service /etc/systemd/system/maj-vaj-reviewed-recovery-review.service
+install_fixed deploy/49-maj-vaj-paper-review.rules /etc/polkit-1/rules.d/49-maj-vaj-paper-review.rules
+install_fixed deploy/maj-vaj-approval-session.desktop /usr/share/xsessions/maj-vaj-approval.desktop
+install_fixed deploy/maj-vaj-review-display.conf /etc/tmpfiles.d/maj-vaj-review-display.conf
+systemd-tmpfiles --create /etc/tmpfiles.d/maj-vaj-review-display.conf
+systemctl daemon-reload
+# Deliberately do not enable the root marker: seat isolation and actual local login must be reviewed first.
+echo 'Installed session artifacts only. Desktop authorization was not activated.'
