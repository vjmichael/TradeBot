+import os
+import socket
+import struct
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+import reserve_review_session as s
+import reserve_review_launcher as r
+from reserve_checkpoint import CheckpointError
+
+HOST = b'test-host'
+
+
+def record(family=256, host=HOST, number=b'12', protocol=b'MIT-MAGIC-COOKIE-1', cookie=b'X'*16):
+    return struct.pack('!H', family) + b''.join(struct.pack('!H', len(v)) + v for v in (host, number, protocol, cookie))
+
+
+class CookieTests(unittest.TestCase):
+    def test_exact_local_record_only(self):
+        local = record()
+        pile = record(family=65535) + record(family=0) + record(host=b'other') + record(number=b'13') + local
+        self.assertEqual(s.select_cookie(pile, ':12.0', HOST), local)
+
+    def test_denies_bad_or_ambiguous_records(self):
+        for bad in (b'', b'x'*65537, record()[:-1], record()+b'x', record()*2, record(family=65535), record(host=b'other'), record(number=b'13'), record(cookie=b'short')):
+            with self.subTest(length=len(bad)), self.assertRaises(CheckpointError):
+                s.select_cookie(bad, ':12', HOST)
+
+    @unittest.skipUnless(os.geteuid()==0, 'root-owned protected parent required')
+    def test_source_custody_and_atomic_retirement(self):
+        with tempfile.TemporaryDirectory(dir='/run') as tmp:
+            home=Path(tmp)/'home';home.mkdir(mode=0o700)
+            a=home/'.Xauthority';a.write_bytes(record());a.chmod(0o600)
+            self.assertEqual(s.read_source(home,0),record())
+            a.chmod(0o644)
+            with self.assertRaises(CheckpointError):s.read_source(home,0)
+            a.chmod(0o600);os.link(a,home/'link')
+            with self.assertRaises(CheckpointError):s.read_source(home,0)
+            (home/'link').unlink();a.unlink();a.symlink_to('/dev/null')
+            with self.assertRaises(OSError):s.read_source(home,0)
+            directory=Path(tmp)/'display';directory.mkdir(mode=0o700);cookie=directory/'Xauthority'
+            with patch.object(r,'DISPLAY_DIR',directory),patch.object(r,'COOKIE',cookie):
+                first=s.install_cookie(0,record(),lambda:None)
+                second=s.install_cookie(0,record(cookie=b'Y'*16),lambda:None)
+                self.assertNotEqual(first,second)
+                s.retire_cookie(0,first);self.assertEqual(cookie.read_bytes(),record(cookie=b'Y'*16))
+                with self.assertRaises(CheckpointError):s.install_cookie(0,record(),Mock(side_effect=CheckpointError('session_changed')))
+                self.assertEqual(cookie.read_bytes(),record(cookie=b'Y'*16))
+                self.assertEqual(list(directory.iterdir()),[cookie])
+                s.retire_cookie(0,second);self.assertFalse(cookie.exists())
+
+    def test_xhost_denies_additional_grants_and_disabled_acl(self):
+        with patch.object(s.subprocess,'run',return_value=Mock(stdout='access control enabled, only authorized clients can connect\n')) as call:
+            r.verify_display(':12');self.assertEqual(call.call_args.kwargs['env']['DISPLAY'],':12')
+        for bad in ('access control disabled, clients can connect from any host\n','access control enabled, only authorized clients can connect\nSI:localuser:maj-vaj\n'):
+            with patch.object(s.subprocess,'run',return_value=Mock(stdout=bad)),self.assertRaises(CheckpointError):r.verify_display(':12')
+
+    def test_provision_refuses_caller_and_foreign_cookie_before_io(self):
+        user=Mock(pw_dir='/home/maj-vaj-approval')
+        with patch.object(r,'authority_uid',return_value=65533),patch.object(r,'_sessions',return_value=('3',':12')),patch.object(r,'caller_session',side_effect=CheckpointError('review_caller_session_required')),patch.object(s,'read_source') as read:
+            with self.assertRaises(CheckpointError):s.provision()
+            read.assert_not_called()
+        with patch.object(r,'authority_uid',return_value=65533),patch.object(r,'_sessions',return_value=('3',':12')),patch.object(r,'caller_session'),patch.object(s.pwd,'getpwuid',return_value=user),patch.dict(os.environ,{'DISPLAY':':12','XAUTHORITY':'/tmp/foreign'}),patch.object(s,'read_source') as read:
+            with self.assertRaises(CheckpointError):s.provision()
+            read.assert_not_called()
+
+    def test_provision_rechecks_and_retires_on_display_failure(self):
+        user=Mock(pw_dir='/home/maj-vaj-approval');ident=(1,2,3,4)
+        def install(uid,data,check):check();return ident
+        with patch.object(r,'authority_uid',return_value=65533),patch.object(r,'_sessions',return_value=('3',':12')),patch.object(r,'caller_session'),patch.object(s.pwd,'getpwuid',return_value=user),patch.object(s.socket,'gethostname',return_value=HOST.decode()),patch.dict(os.environ,{'DISPLAY':':12','XAUTHORITY':'/home/maj-vaj-approval/.Xauthority'}),patch.object(s,'read_source',return_value=record()),patch.object(s,'install_cookie',side_effect=install),patch.object(r,'verify_display',side_effect=CheckpointError('display_denied')),patch.object(s,'retire_cookie') as retire:
+            with self.assertRaises(CheckpointError):s.provision()
+            retire.assert_called_once_with(65533,ident)
