+#!/usr/bin/env python3
+"""Disposable local Xvfb cookie interoperability only (not installed desktop acceptance)."""
+import os
+import pathlib
+import pwd
+import secrets
+import subprocess
+import sys
+import tempfile
+import time
+
+from reserve_review_session import select_cookie
+
+
+def main():
+    assert os.geteuid() == 0, 'independent UID test requires disposable root test host'
+    approval = pwd.getpwnam('nobody')
+    other = pwd.getpwnam('daemon')
+    assert approval.pw_uid != other.pw_uid != 0
+    with tempfile.TemporaryDirectory(prefix='maj-vaj-test-', dir='/run') as name:
+        base = pathlib.Path(name); base.chmod(0o755)
+        home, runtime = base/'home', base/'display'
+        for p in (home, runtime):
+            p.mkdir(mode=0o700); os.chown(p, approval.pw_uid, approval.pw_gid)
+        source = home/'.Xauthority'; source.touch(mode=0o600)
+        os.chown(source, approval.pw_uid, approval.pw_gid)
+        display = next(':'+str(i) for i in range(105, 150) if not pathlib.Path('/tmp/.X11-unix/X'+str(i)).exists() and not pathlib.Path('/tmp/.X'+str(i)+'-lock').exists())
