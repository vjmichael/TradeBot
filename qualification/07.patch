+"""Disposable offline QEMU acceptance. Synthetic keys, no network or trading.
+Requires root-reviewed deployment of the staged gateway, socket, backend and vault.
+Never print marker values, systemd logs, crash output, or exception messages.
+"""
+import base64
+import json
+import os
+from pathlib import Path
+import pwd
+import secrets
+import socket
+import subprocess
+import sys
+import tempfile
+import time
+import urllib.error
+import urllib.request
+
+DASH='maj-vaj-paper-dashboard.service'
+BACK='maj-vaj-paper-dashboard-backend.service'
+VAULT='maj-vaj-paper-vault.service'
+SOCK='maj-vaj-dashboard-backend.socket'
+AUTH='maj-vaj-dashboard-auth'
+OP='maj-vaj-credential-operator'
+PY='/opt/maj-vaj/venv/bin/python'
+DATA=Path('/var/lib/maj-vaj/data')
+KEYS=Path('/etc/maj-vaj/credential-keys')
+TOKEN=KEYS/'dashboard-token'
+PRIVATE=Path('/run/maj-vaj-dashboard-private/backend.sock')
+STORE=Path('/var/lib/maj-vaj-paper-vault')
+COPIES=DATA.parent/'data-recovery-copies'
+
+
+def cmd(*args):
+    return subprocess.check_output(args,stderr=subprocess.DEVNULL)
+
+
+def proc(unit):
+    return int(cmd('systemctl','show','-p','MainPID','--value',unit))
+
+
+def check(name, condition):
+    if not condition: raise RuntimeError(name)
+    print('PASS_'+name,flush=True)
+
+
+def as_user(user, source, body=None):
+    return subprocess.run(['runuser','-u',user,'--',PY,'-I','-B','-c',source],
+                          input=body,capture_output=True)
+
+
+def vault(request):
+    source='import sys,json;sys.path.insert(0,"/opt/maj-vaj");from paper_credential_vault import send;print(json.dumps(send(json.load(sys.stdin))))'
+    r=as_user(OP,source,json.dumps(request).encode())
+    return json.loads(r.stdout) if r.returncode==0 else {'ok':False}
+
+
+def api(path,token=None,body=None):
+    headers={'Authorization':'Bearer '+token} if token else {}
+    if body is not None: headers['Content-Type']='application/json'
+    req=urllib.request.Request('http://127.0.0.1:8765'+path,headers=headers,
+                               data=json.dumps(body).encode() if body is not None else None)
+    try:
