+from market_memory import MarketMemory
+from pathlib import Path
+m=MarketMemory(Path("/var/lib/maj-vaj/data")); t=1704067200
+m.record_recent("BTC/USD",60, {"exchange":"kraken","product":"spot","pair":"BTC/USD","interval_minutes":60,"observed_at":t+7200,"candles":[[t*1000,"100.125","101","99","100.125","2.0",4],[(t+3600)*1000,"100.125","101","99","100.125","2.0",4]]},now=t+7200)
