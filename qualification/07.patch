+++ b/dashboard_auth_gateway.py
@@ -0,0 +1,160 @@
+"""Loopback-only PAPER gateway. No desk data access or bearer forwarding.
+
+The backend socket is created by systemd, root-owned and connectable only by
+this dedicated principal. Never expose the backend on TCP. This is not TLS
+or remote deployment authorization.
+"""
+import hmac
+import os
+import pwd
+import socket
+import stat
+from pathlib import Path
+
+import httpx
+from fastapi import FastAPI, Request
+from fastapi.responses import JSONResponse, Response
+
+from paper_credential_vault import harden_process, load_service_credential
+
+AUTH_USER = 'maj-vaj-dashboard-auth'
+BACKEND_SOCKET = '/run/maj-vaj-dashboard-private/backend.sock'
+PUBLIC = frozenset(('/', '/health', '/assets/app.js', '/assets/style.css',
+                    '/assets/react.js', '/assets/react-dom.js'))
+MAX_REQUEST = 65536
+MAX_RESPONSE = 32 * 1024 * 1024
+SECURITY_HEADERS = {
+    'Cache-Control': 'no-store',
+    'Content-Security-Policy': "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
+    'X-Content-Type-Options': 'nosniff', 'Referrer-Policy': 'no-referrer',
+    'X-Frame-Options': 'DENY',
+}
+
+
+def _require_private_socket(path=BACKEND_SOCKET):
+    import grp
+    group = grp.getgrnam(AUTH_USER)
+    auth = pwd.getpwnam(AUTH_USER)
+    if (auth.pw_gid != group.gr_gid or any(name != AUTH_USER for name in group.gr_mem)
+            or any(p.pw_gid == group.gr_gid and p.pw_name != AUTH_USER for p in pwd.getpwall())):
+        raise PermissionError('dashboard group separation refused')
+    path = Path(path)
+    parent = path.parent.lstat()
+    entry = path.lstat()
+    if (not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0 or parent.st_mode & 0o022
+            or not stat.S_ISSOCK(entry.st_mode) or entry.st_uid != 0
+            or entry.st_gid != group.gr_gid
+            or stat.S_IMODE(entry.st_mode) != 0o660):
+        raise PermissionError('dashboard transport refused')
+
+
+def installed_backend_fd():
+    """Only accept the manager's fixed listening socket; no TCP fallback."""
+    if (os.getuid() != pwd.getpwnam('maj-vaj').pw_uid
+            or os.environ.get('LISTEN_PID') != str(os.getpid())
+            or os.environ.get('LISTEN_FDS') != '1'
+            or os.environ.get('LISTEN_FDNAMES') != 'maj-vaj-dashboard-backend'):
+        raise PermissionError('dashboard transport refused')
+    _require_private_socket()
+    with socket.fromfd(3, socket.AF_UNIX, socket.SOCK_STREAM) as listener:
+        if (listener.getsockname() != BACKEND_SOCKET
+                or listener.getsockopt(socket.SOL_SOCKET, socket.SO_TYPE) != socket.SOCK_STREAM
+                or not listener.getsockopt(socket.SOL_SOCKET, socket.SO_ACCEPTCONN)):
+            raise PermissionError('dashboard transport refused')
+    os.set_inheritable(3, False)
+    for name in ('LISTEN_PID', 'LISTEN_FDS', 'LISTEN_FDNAMES'):
+        os.environ.pop(name, None)
+    return 3
+
+
+def create_gateway(token, transport):
+    if (not isinstance(token, str) or len(token) < 32 or len(token) > 512
+            or not token.isascii() or any(not 33 <= ord(c) <= 126 for c in token)):
+        raise ValueError('dashboard authentication unavailable')
+    expected = ('Bearer ' + token).encode('ascii')
+    app = FastAPI(docs_url=None, redoc_url=None, openapi_url=None)
+
+    def error(status, detail):
+        return JSONResponse({'detail': detail}, status_code=status, headers=SECURITY_HEADERS)
+
+    @app.middleware('http')
+    async def forward(request: Request, _call_next):
+        hosts = request.headers.getlist('host')
+        if len(hosts) != 1 or hosts[0] not in ('127.0.0.1:8765', 'localhost:8765', '127.0.0.1', 'localhost'):
+            return error(400, 'Host not allowed')
+        method = request.method
+        path = request.scope.get('raw_path', b'')
+        if (method not in ('GET', 'HEAD', 'POST') or not path.startswith(b'/')
+                or len(path) > 1024 or any(c < 33 or c > 126 for c in path)
+                or any(x in path for x in (b'%', b'\\', b'?', b'#', b'//'))
+                or any(part in (b'.', b'..') for part in path.split(b'/'))):
+            return error(400, 'Request refused')
+        origins = request.headers.getlist('origin')
+        if origins and origins != [str(request.base_url).rstrip('/')]:
+            return error(403, 'Origin not allowed')
+        auth = [v for k, v in request.scope['headers'] if k == b'authorization']
+        public = method in ('GET', 'HEAD') and path.decode('ascii') in PUBLIC
+        if not public and (len(auth) != 1 or not hmac.compare_digest(auth[0], expected)):
+            return error(401, 'Unauthorized')
+        # Installed enrollment is exclusively local to the independent vault.
+        if path.rstrip(b'/') == b'/api/setup/credentials':
+            return error(503, 'Credential enrollment unavailable')
+        if request.headers.get('content-encoding') not in (None, 'identity'):
+            return error(400, 'Request refused')
+        query = request.scope.get('query_string', b'')
+        if len(query) > 8192:
+            return error(400, 'Request refused')
+        body = bytearray()
+        async for chunk in request.stream():
+            if len(body) + len(chunk) > MAX_REQUEST:
+                return error(413, 'Request too large')
+            body.extend(chunk)
+        if (method != 'POST' and body) or (body and request.headers.get('content-type', '').split(';')[0] != 'application/json'):
+            return error(400, 'Request refused')
+        # Defense in depth: reject accidental placement of the bearer in a URL
+        # or payload (the header itself is never forwarded).
+        from urllib.parse import unquote_to_bytes
+        from base64 import b64encode
+        secret = expected[7:]
+        variants = (secret, secret.hex().encode(), b64encode(secret))
+        if any(v in unquote_to_bytes(query) or v in body or v in path for v in variants):
+            return error(400, 'Request refused')
+        headers = {'content-type': 'application/json'} if method == 'POST' else {}
+        url = httpx.URL('http://localhost', raw_path=path + (b'?' + query if query else b''))
+        try:
+            # No proxy environment, redirect, external destination or cookie jar
+            # shared between calls. A single UDS transport is fixed by startup.
+            async with httpx.AsyncClient(transport=transport(), trust_env=False,
+                                         follow_redirects=False, timeout=60) as client:
+                async with client.stream(method, url, headers=headers, content=bytes(body)) as upstream:
+                    if 300 <= upstream.status_code < 400:
+                        return error(502, 'Dashboard unavailable')
+                    response = bytearray()
+                    async for chunk in upstream.aiter_bytes():
+                        if len(response) + len(chunk) > MAX_RESPONSE:
+                            return error(502, 'Dashboard unavailable')
+                        response.extend(chunk)
+                    if any(v in response for v in variants):
+                        return error(502, 'Dashboard unavailable')
+                    out = dict(SECURITY_HEADERS)
+                    out['Content-Type'] = upstream.headers.get('content-type', 'application/octet-stream')
+                    return Response(bytes(response), status_code=upstream.status_code, headers=out)
+        except (httpx.HTTPError, OSError, ValueError):
+            return error(503, 'Dashboard unavailable')
+
+    return app
+
+
+def run():
+    import uvicorn
+    if os.getuid() != pwd.getpwnam(AUTH_USER).pw_uid:
+        raise PermissionError('dashboard identity refused')
+    harden_process()
+    os.umask(0o077)
+    # The root-managed socket group must not grant the desk role membership.
+    _require_private_socket()
+    token = load_service_credential('dashboard-token').decode('ascii')
+    app = create_gateway(token, lambda: httpx.AsyncHTTPTransport(uds=BACKEND_SOCKET))
+    uvicorn.run(app, host='127.0.0.1', port=8765, access_log=False,
+                log_level='warning', proxy_headers=False, server_header=False,
+                limit_concurrency=64, timeout_keep_alive=5)
