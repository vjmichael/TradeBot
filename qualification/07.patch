+    except urllib.error.HTTPError as e:return e.code,e.read()
+
+
+def ready(token):
+    for _ in range(30):
+        try:
+            if api('/api/status',token)[0]==200:return True
+        except (OSError,urllib.error.URLError):pass
+        time.sleep(.5)
+    return False
+
+
+def replace_token(value):
+    fd,tmp=tempfile.mkstemp(dir=KEYS)
+    try:
+        with os.fdopen(fd,'wb') as f:f.write(value.encode());f.flush();os.fsync(f.fileno())
+        os.replace(tmp,TOKEN)
+        fd=os.open(KEYS,os.O_DIRECTORY)
+        try:os.fsync(fd)
+        finally:os.close(fd)
+    finally:
+        if os.path.exists(tmp):os.unlink(tmp)
+
+
+def run():
+    assert sys.argv[1:]==['--disposable-offline-guest'] and os.getuid()==0
+    assert set(os.listdir('/sys/class/net'))=={'lo'} and cmd('systemd-detect-virt').strip()==b'qemu'
+    assert Path('/etc/maj-vaj/paper-dashboard-qualification-enabled').is_file()
