+"""Synthetic vault fault qualification, disposable offline QEMU guest only."""
+import json,os,pathlib,pwd,shutil,sqlite3,subprocess,secrets,sys,time,tempfile,hashlib
+from cryptography.fernet import Fernet
+UNIT='maj-vaj-paper-vault.service'; ROOT=pathlib.Path('/var/lib/maj-vaj-paper-vault'); KEY=pathlib.Path('/etc/maj-vaj/credential-keys/venue-vault-key'); DB=ROOT/'vault.sqlite3'; PY='/opt/maj-vaj/venv/bin/python'
+def cmd(*args):return subprocess.run(args,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode
+
+def request(body):
+    code='import sys,json;sys.path.insert(0,"/opt/maj-vaj");from paper_credential_vault import send;print(json.dumps(send(json.load(sys.stdin))))'
+    r=subprocess.run(['runuser','-u','maj-vaj-credential-operator','--',PY,'-I','-B','-c',code],input=json.dumps(body).encode(),capture_output=True)
+    return json.loads(r.stdout) if r.returncode==0 else {'ok':False}
+
+def start():
+    cmd('systemctl','reset-failed',UNIT);cmd('systemctl','start',UNIT)
+    for _ in range(25):
+        if request({'op':'status'}).get('ok'):return True
+        if cmd('systemctl','is-failed','--quiet',UNIT)==0:return False
+        time.sleep(.4)
+    return False
+
+def check(name,condition):
+    if not condition:raise RuntimeError(name)
+    print('PASS_'+name,flush=True)
+
+def stop():assert cmd('systemctl','stop',UNIT)==0
+
+def replace_file(path,data,uid,gid):
+    fd,tmp=tempfile.mkstemp(dir=path.parent)
+    try:
+        os.fchmod(fd,0o600);os.fchown(fd,uid,gid)
+        with os.fdopen(fd,'wb') as f:f.write(data);f.flush();os.fsync(f.fileno())
+        os.replace(tmp,path)
+    finally:
+        if os.path.exists(tmp):os.unlink(tmp)
+
+def main():
+    assert sys.argv[1:]==['--disposable-offline-guest'] and os.getuid()==0 and set(os.listdir('/sys/class/net'))=={'lo'} and cmd('systemd-detect-virt','--quiet','--vm')==0
+    assert pathlib.Path('/etc/maj-vaj/paper-vault-enabled').exists()
+    assert request({'op':'status'}).get('ok') and all(v=='not_configured' for v in request({'op':'status'})['credentials'].values())
+    synthetic='synthetic-'+secrets.token_hex(32)
+    assert request({'op':'enroll','values':{'grok':synthetic}}).get('ok')
+    stop();key=KEY.read_bytes();db=DB.read_bytes();st=DB.stat()
+    try:
+        replace_file(KEY,Fernet.generate_key(),0,0)
+        check('INSTALLED_WRONG_KEK_REFUSED',not start() and not request({'op':'status'}).get('ok') and DB.read_bytes()==db)
+        stop();replace_file(KEY,key,0,0);check('ORIGINAL_KEK_RESTORES',start() and request({'op':'status'})['credentials']['grok']=='stored_unverified');stop()
+        with sqlite3.connect(DB) as conn:conn.execute("UPDATE secrets SET ciphertext=? WHERE slot='grok'",(b'corrupted-synthetic-ciphertext',))
+        bad=DB.read_bytes();check('INSTALLED_TAMPER_REFUSED',not start() and not request({'op':'status'}).get('ok') and DB.read_bytes()==bad)
+        stop();replace_file(DB,db,st.st_uid,st.st_gid);check('CONTROLLED_ENCRYPTED_FIXTURE_RESTORATION',start() and request({'op':'status'})['credentials']['grok']=='stored_unverified')
+        check('SYNTHETIC_CLEANUP',request({'op':'remove','slots':['grok']}).get('ok') and all(v=='not_configured' for v in request({'op':'status'})['credentials'].values()))
+    finally:
+        # Do not leave the deliberately corrupted fixture in use. Original bytes retained solely in root-only test process.
+        stop();replace_file(KEY,key,0,0)
+        if not start():
+            stop();replace_file(DB,db,st.st_uid,st.st_gid);start()
+        request({'op':'remove','slots':['grok']})
+
+if __name__=='__main__':
+    try:main()
+    except Exception as e:
+        print('FAIL_'+(str(e) if isinstance(e,RuntimeError) and str(e).isupper() else type(e).__name__),flush=True);sys.exit(1)
