+    assert all(v=='not_configured' for v in request({'op':'status'})['credentials'].values())
+    check('IDENTITIES',pid(UNIT)>0 and pid(DASH)>0 and real_uid(pid(UNIT))==pwd.getpwnam('maj-vaj-vault').pw_uid and real_uid(pid(DASH))==pwd.getpwnam('maj-vaj').pw_uid)
+    vals={'kraken_read_key':markers[0].decode(),'kraken_read_secret':markers[1].decode(),'grok':markers[2].decode()}
