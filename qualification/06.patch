+import base64
+import json
+import os
+from pathlib import Path
+import sqlite3
+import tempfile
+import threading
+import unittest
+from concurrent.futures import ThreadPoolExecutor
+from cryptography.fernet import Fernet
+from paper_credential_vault import PaperVault, dispatch, Server, send
+
+
+class PaperCredentialVaultTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(); self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name); self.key = Fernet.generate_key()
+        self.vault = PaperVault(self.root, self.key)
+
+    def assert_private(self, values):
+        for v in values:
+            raw=v.encode()
+            for p in self.root.glob('vault.sqlite3*'):
+                data=p.read_bytes()
+                for form in (raw,base64.b64encode(raw),raw.hex().encode()):
+                    self.assertNotIn(form,data)
+
+    def test_atomic_pair_write_replace_remove_and_restart(self):
+        vals={'kraken_read_key':'synthetic-test-key-121','kraken_read_secret':'synthetic-test-secret-122'}
+        self.assertFalse(dispatch(self.vault,{'op':'enroll','values':{'kraken_read_key':vals['kraken_read_key']}})['ok'])
+        r=dispatch(self.vault,{'op':'enroll','values':vals});self.assertTrue(r['ok']);self.assertFalse(r['connections_verified'])
+        self.assert_private(vals.values());self.assertFalse(any(v in json.dumps(r) for v in vals.values()))
+        self.assertEqual(PaperVault(self.root,self.key).status(),r)
+        self.assertFalse(dispatch(self.vault,{'op':'remove','slots':['kraken_read_key']})['ok'])
+        r=dispatch(self.vault,{'op':'enroll','values':{k:v+'-rotated' for k,v in vals.items()}});self.assertTrue(r['ok'])
+        self.assert_private([*vals.values(),*(v+'-rotated' for v in vals.values())])
+        self.assertTrue(dispatch(self.vault,{'op':'remove','slots':list(vals)})['ok']);self.assertFalse(any(s=='stored_unverified' for s in self.vault.status()['credentials'].values()))
+
+    def test_bad_fields_and_no_plaintext_read(self):
+        marker='synthetic-test-marker-123'
+        for req in [{'op':'read','slot':'grok'},{'op':'export'},{'op':'enroll','values':{'seed_phrase':marker}},{'op':'enroll','values':{'grok':marker+' space'}},{'op':'status','extra':marker},{'op':'enroll','values':{'grok':{'nested':marker}}}]:
+            r=dispatch(self.vault,req);self.assertFalse(r['ok']);self.assertNotIn(marker,json.dumps(r))
+
+    def test_wrong_key_and_tamper_refused_without_replacement(self):
+        self.vault.enroll({'grok':'synthetic-marker-456'})
+        with self.assertRaises(Exception):PaperVault(self.root,Fernet.generate_key())
+        with sqlite3.connect(self.vault.path) as db:db.execute("UPDATE secrets SET ciphertext=? WHERE slot='grok'",(b'broken',))
+        for request in ({'op':'status'},{'op':'enroll','values':{'grok':'new'}},{'op':'remove','slots':['grok']}):
+            self.assertFalse(dispatch(self.vault,request)['ok'])
+        with sqlite3.connect(self.vault.path) as db:self.assertEqual(db.execute('SELECT ciphertext FROM secrets').fetchone()[0],b'broken')
+
+    def test_concurrent_pair_updates(self):
