+        if p.is_file():assert clean(p.read_bytes()) and p.name not in ('desk.sqlite3','vault.sqlite3','venue-vault-key','dashboard-token'),'backup_leak'
+    check('ACTUAL_MARKET_BACKUP_NONDISCLOSURE',True)
+    print('WORKER_PROCESS_OBSERVED='+str(child_seen),flush=True)
+    check('LOCAL_REMOVAL',request({'op':'remove','slots':list(vals)}).get('ok') and all(v=='not_configured' for v in request({'op':'status'})['credentials'].values()))
