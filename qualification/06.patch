+    # Synthetic requests via stdin pipe, not argv/env; helper never prints values.
+    code='import sys,json;sys.path.insert(0,"/opt/maj-vaj");from paper_credential_vault import send;print(json.dumps(send(json.load(sys.stdin))))'
+    s=subprocess.run(['runuser','-u',user,'--',PY,'-I','-B','-c',code],input=json.dumps(op).encode(),capture_output=True)
+    return json.loads(s.stdout) if s.returncode==0 else {'ok':False}
+def api(path, token=None, body=None):
+    headers={'Authorization':'Bearer '+token} if token else {}
+    if body is not None:headers['Content-Type']='application/json'
+    r=urllib.request.Request('http://127.0.0.1:8765'+path,headers=headers,data=json.dumps(body).encode() if body is not None else None)
+    try:
+        with urllib.request.urlopen(r,timeout=6) as s:return s.status,s.read()
+    except urllib.error.HTTPError as e:return e.code,e.read()
+def check(name,cond):
+    if not cond:raise RuntimeError(name)
+    print('PASS_'+name,flush=True)
+
+def forms(v):return (v,base64.b64encode(v),v.hex().encode())
+markers=[('synthetic-'+secrets.token_hex(24)).encode() for i in range(7)]
+key=(CREDS/'venue-vault-key').read_bytes(); token=(CREDS/'dashboard-token').read_text(); allmarkers=markers+[key,token.encode()]
+
+def clean(data, values=allmarkers):return not any(form in data for v in values for form in forms(v))
+
