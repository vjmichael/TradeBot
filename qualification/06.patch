+    check('PRIVATE_FILES',True)
+    for u in [OP,'maj-vaj','maj-vaj-approval','maj-vaj-native']:
+        for p in [pathlib.Path('/run/credentials/maj-vaj-paper-vault.service/venue-vault-key'),pathlib.Path(f'/proc/{pid(UNIT)}/mem')]:
+            assert subprocess.run(['runuser','-u',u,'--','test','-r',str(p)]).returncode!=0
+    check('VAULT_RUNTIME_CUSTODY',True)
