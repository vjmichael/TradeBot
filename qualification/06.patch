+    check('HTTP_AUTH_AND_ENROLLMENT_FENCE',api('/api/setup')[0]==401 and api('/api/setup',token)[0]==200 and api('/api/setup/credentials',token,{'grok':markers[5].decode()})[0]==503 and api('/api/setup/credentials',token,{'seed_phrase':markers[6].decode()})[0]==422)
+    def replace(i):return request({'op':'enroll','values':{'kraken_read_key':markers[0].decode()+str(i),'kraken_read_secret':markers[1].decode()+str(i)}})
+    with ThreadPoolExecutor(max_workers=3) as pool:assert all(r.get('ok') for r in pool.map(replace,range(6)))
+    with sqlite3.connect(ROOT/'vault.sqlite3') as db:
+        pair={s:Fernet(key).decrypt(b)[-1:] for s,b in db.execute("SELECT slot,ciphertext FROM secrets WHERE slot LIKE 'kraken_read_%'")}
+    check('ATOMIC_CONCURRENT_ROTATION',len(pair)==2 and len(set(pair.values()))==1)
+    subprocess.check_call(['systemctl','restart',UNIT],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+    for _ in range(40):
+        if request({'op':'status'}).get('ok'):break
+        time.sleep(.5)
+    check('RESTART_PERSISTENCE',request({'op':'status'}).get('credentials',{}).get('grok')=='stored_unverified')
+    audit_blobs();check('NONDISCLOSURE_DB_PROCESS_JOURNAL_HTTP',True)
+    # Real allowlisted market backup from installed dashboard, while synthetic credentials are enrolled.
+    backup_root=pathlib.Path('/var/lib/maj-vaj/data-recovery-copies')
+    status,body=api('/api/data-maintenance/backup',token,{})
+    assert status==200 and clean(body),'backup_start'
