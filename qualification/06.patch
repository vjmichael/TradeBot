+test ! -e /var/lib/maj-vaj-paper-vault
+test "$(ps -p 1 -o comm=)" = systemd
+test "$(ls /sys/class/net)" = lo
+for u in maj-vaj-vault maj-vaj-credential-operator; do if ! getent passwd "$u" >/dev/null; then useradd --system --user-group --no-create-home --shell /usr/sbin/nologin "$u"; fi; done
+install -d -o root -g root -m0700 /etc/maj-vaj/credential-keys
+/opt/maj-vaj/venv/bin/python - <<'PY'
+import os,secrets
+from cryptography.fernet import Fernet
+for name,value in [('venue-vault-key',Fernet.generate_key()),('dashboard-token',secrets.token_urlsafe(48).encode())]:
+    fd=os.open('/etc/maj-vaj/credential-keys/'+name,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
+    with os.fdopen(fd,'wb') as f:f.write(value)
+PY
+for f in paper_credential_vault.py tradebot.py; do install -o root -g root -m644 /mnt/deps/"$f" /opt/maj-vaj/"$f"; cmp /mnt/deps/"$f" /opt/maj-vaj/"$f"; done
+for f in /mnt/deps/*.service; do install -o root -g root -m644 "$f" /etc/systemd/system/; cmp "$f" /etc/systemd/system/"${f##*/}"; done
+install -d -o maj-vaj -g maj-vaj -m700 /var/lib/maj-vaj/data-recovery-copies
+systemctl daemon-reload
+systemd-analyze verify /etc/systemd/system/maj-vaj-paper-vault.service /etc/systemd/system/maj-vaj-paper-dashboard.service
+# No opt-in markers: services must remain inactive.
+systemctl start maj-vaj-paper-vault.service maj-vaj-paper-dashboard.service
+! systemctl is-active --quiet maj-vaj-paper-vault.service
+! systemctl is-active --quiet maj-vaj-paper-dashboard.service
+echo PASS_MARKER_REFUSAL
+install -m644 /dev/null /etc/maj-vaj/paper-vault-enabled
+install -m644 /dev/null /etc/maj-vaj/paper-dashboard-qualification-enabled
+systemctl start maj-vaj-paper-vault.service maj-vaj-paper-dashboard.service
+for i in $(seq 1 60); do if test -S /run/maj-vaj-paper-vault/enroll.sock && /opt/maj-vaj/venv/bin/python -c 'import urllib.request; urllib.request.urlopen("http://127.0.0.1:8765/",timeout=1)' 2>/dev/null; then break; fi; sleep 1; done
+test -S /run/maj-vaj-paper-vault/enroll.sock
+systemctl is-active maj-vaj-paper-vault.service maj-vaj-paper-dashboard.service
