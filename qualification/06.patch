+    check('SEPARATE_PRINCIPALS',all(not request({'op':'status'},u).get('ok') for u in ['maj-vaj','maj-vaj-approval','maj-vaj-native']))
+    for u in [OP,'maj-vaj','maj-vaj-approval','maj-vaj-native']:
