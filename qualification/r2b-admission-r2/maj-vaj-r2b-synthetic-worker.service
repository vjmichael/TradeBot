[Unit]
Description=Maj Vaj isolated synthetic-only no-network provider denial worker
ConditionPathExists=/etc/maj-vaj/r2b-approval-test-enabled
After=systemd-user-sessions.service

[Service]
Type=simple
User=maj-vaj-r2b-worker
Group=maj-vaj-r2b-worker
SupplementaryGroups=maj-vaj-vault
WorkingDirectory=/opt/maj-vaj
ExecStart=/opt/maj-vaj/venv/bin/python -I -B /opt/maj-vaj/r2b-admission-r2/synthetic_worker_service.py
LoadCredential=r2b-worker-signing-key:/etc/maj-vaj/credential-keys/r2b-worker-signing-key
RuntimeDirectory=maj-vaj-r2b-synthetic-worker
RuntimeDirectoryMode=0711
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LimitCORE=0
StandardOutput=null
StandardError=null
Restart=no
TimeoutStopSec=5s

[Install]
WantedBy=multi-user.target
