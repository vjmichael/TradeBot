@@ -0,0 +1,122 @@
+"""Disposable synthetic-only private gateway/browser qualification.
+
+Run serve under the pinned server runtime, then browser under Playwright. The
+optional compatibility assets are for an explicitly nonqualifying smoke test.
+Never use against a real desk; the test creates a fresh local vault and backend.
+"""
+import argparse
+from pathlib import Path
+import base64
+import os
+import sys
+import tempfile
+import threading
+import time
+
+ROOT = Path(__file__).resolve().parents[1]
+TOKEN = 'synthetic-r2ar1-browser-bearer-' * 2
+CANARY = 'synthetic-r2ar1-provider-value-not-for-browser'
+BASE = 'http://127.0.0.1:8765'
+
+
+def serve(directory, assets):
+    sys.path.insert(0, str(ROOT))
+    from cryptography.fernet import Fernet
+    from paper_credential_vault import PaperVault, Server, send, checked_status
+    import paper_credential_vault
+    from tradebot import create_app
+    from dashboard_auth_gateway import create_gateway
+    import httpx
+    import uvicorn
+    if not directory.is_dir() or any(directory.iterdir()):
+        raise RuntimeError('empty disposable fixture directory required')
+    vault_dir = directory / 'vault'; vault_dir.mkdir(mode=0o700)
+    vault = PaperVault(vault_dir, Fernet.generate_key())
+    vault.enroll({'grok':CANARY})
+    status = Server(directory/'status.sock', vault, os.getuid(), read_only=True)
+    worker = threading.Thread(target=status.serve_forever,daemon=True);worker.start()
+    paper_credential_vault.dashboard_status = lambda: checked_status(send({'op':'status'}, directory/'status.sock', os.getuid()))
+    backend_path = str(directory/'backend.sock')
+    backend=uvicorn.Server(uvicorn.Config(create_app(directory/'desk',None,_private_backend=True,dashboard_dir=assets),uds=backend_path,access_log=False,log_level='warning'))
+    thread=threading.Thread(target=backend.run,daemon=True);thread.start()
+    for _ in range(200):
+        if backend.started:break
+        time.sleep(.05)
+    else:raise RuntimeError('backend did not start')
+    try:
+        uvicorn.run(create_gateway(TOKEN,lambda:httpx.AsyncHTTPTransport(uds=backend_path)),host='127.0.0.1',port=8765,access_log=False,log_level='warning',proxy_headers=False)
+    finally:
+        backend.should_exit=True;thread.join(10);status.shutdown();worker.join(5);status.server_close()
+
+
+def browser(directory, executable, expected_version):
+    from playwright.sync_api import sync_playwright, expect
+    errors=[]; external=[]; leaks=[]; requests=[]
+    variants = [v for x in (TOKEN,CANARY) for v in (x.encode(),x.encode().hex().encode(),base64.b64encode(x.encode()))]
+    def check_storage(page):
+        data=page.evaluate('''async()=>({local:Object.keys(localStorage),session:Object.keys(sessionStorage),cookies:document.cookie,db:(await indexedDB.databases()).length,caches:(await caches.keys()).length,workers:(await navigator.serviceWorker.getRegistrations()).length})''')
+        assert data=={'local':[],'session':[],'cookies':'','db':0,'caches':0,'workers':0},'unexpected browser state'
+    def sign_in(page):
+        page.get_by_label('Admin access token').fill(TOKEN)
+        page.get_by_role('button',name='Sign in',exact=True).click()
+        expect(page.get_by_role('heading',name='Dashboard',exact=True)).to_be_visible()
+    def open_settings(page):
+        page.get_by_role('button',name='Settings',exact=True).click()
+        expect(page.get_by_text('Grok API key · Stored · not verified',exact=True)).to_be_visible()
+        assert page.locator('input[type=password]').count()==0
