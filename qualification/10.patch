+#!/bin/bash
+# Root-reviewed staging only. Never creates a login password, enables a marker,
+# changes an existing session, or enables exchange access.
+set -euo pipefail
+[[ $# == 1 && ( $1 == --check || $1 == --install ) ]] || exit 2
+[[ $EUID == 0 && $(cat /proc/1/comm) == systemd ]] || exit 1
+cd /opt/maj-vaj
+for p in chromium xdg-utils lightdm lightdm-gtk-greeter xserver-xorg-core x11-xserver-utils xauth libpam-systemd libsystemd0; do
+ [[ $(dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null || :) == 'ii ' ]] || { echo "Missing installed package: $p" >&2; exit 1; }
+done
+venv/bin/python -I -B - <<'PY'
+import grp,os,pwd,stat,tkinter
+from pathlib import Path
+names=('maj-vaj-console','maj-vaj-credential-operator','maj-vaj-vault','maj-vaj','maj-vaj-dashboard-auth','maj-vaj-approval','maj-vaj-native')
+users=[pwd.getpwnam(n) for n in names];p=users[0]
+assert all(u.pw_uid>0 for u in users) and len({u.pw_uid for u in users})==len(users)
+assert p.pw_gid==grp.getgrnam(p.pw_name).gr_gid and p.pw_gid not in {u.pw_gid for u in users[1:]}
+assert set(os.getgrouplist(p.pw_name,p.pw_gid))=={p.pw_gid}
+assert all(u.pw_gid!=p.pw_gid or u.pw_name==p.pw_name for u in pwd.getpwall())
+assert set(grp.getgrnam(p.pw_name).gr_mem)<={p.pw_name}
+home=Path(p.pw_dir);st=home.lstat()
+assert home.is_absolute() and home!=Path('/') and stat.S_ISDIR(st.st_mode) and st.st_uid==p.pw_uid and stat.S_IMODE(st.st_mode)==0o700
+assert p.pw_shell not in ('/usr/sbin/nologin','/sbin/nologin','/bin/false') and os.access(p.pw_shell,os.X_OK)
+assert not Path('/var/lib/systemd/linger/maj-vaj-console').exists()
+for n in ('.','credential_handoff.py','scripts','scripts/account_handoff_wrapper.sh','scripts/account_console_wrapper.sh','scripts/review_session_wrapper.sh','deploy','deploy/maj-vaj-account-handoff.desktop','deploy/maj-vaj-console.desktop'):
+ s=Path(n).lstat();assert s.st_uid==0 and not s.st_mode&0o022 and not stat.S_ISLNK(s.st_mode)
+for n in ('scripts/account_handoff_wrapper.sh','scripts/account_console_wrapper.sh','scripts/review_session_wrapper.sh'):
+ assert os.access(n,os.X_OK)
+print('Dedicated local console source and identity preflight passed.')
+PY
+[[ $1 == --install ]] || exit 0
+for pair in 'deploy/maj-vaj-console.desktop:/usr/share/xsessions/maj-vaj-console.desktop' 'deploy/maj-vaj-account-handoff.desktop:/usr/share/applications/maj-vaj-account-handoff.desktop'; do
+ src=${pair%%:*}; dest=${pair#*:}
+ if [[ -e $dest || -L $dest ]];then
+  [[ ! -L $dest && -f $dest && $(stat -c '%u:%a' "$dest") == 0:644 ]] && cmp -s "$src" "$dest" || exit 1
+ else
+  install -o root -g root -m644 "$src" "$dest"
+ fi
+done
+if command -v update-desktop-database >/dev/null; then update-desktop-database /usr/share/applications; fi
+echo 'Installed console and URI entries. Review the dedicated seat setup and activate account-handoff-enabled separately.'
