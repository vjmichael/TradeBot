diff --git a/tests/test_credential_handoff.py b/tests/test_credential_handoff.py
new file mode 100644
index 0000000..685ba50
--- /dev/null
+++ b/tests/test_credential_handoff.py
@@ -0,0 +1,69 @@
+"""Handoff intent is never authority; synthetic state only."""
+from contextlib import contextmanager
+import unittest
+from unittest.mock import Mock, patch
+from credential_handoff import URI, handoff, identity, validate_uri, terminate
+
+
+class HandoffTests(unittest.TestCase):
+    def setUp(self):
+        self.initial = ('c42', ':0', '/home/test/.Xauthority', b'cookie-digest')
+        self.snapshot = Mock(return_value=self.initial)
+        self.ask = Mock(return_value=True)
+        self.end = Mock()
+        self.check = Mock()
+        @contextmanager
+        def events(session):
+            self.assertEqual(session, self.initial[0])
+            yield type('Events', (), {'check': self.check})()
+        self.events = events
+
+    def run_handoff(self, args=(URI,)):
+        return handoff(args, snapshot=self.snapshot, events_factory=self.events,
+                       ask=self.ask, end=self.end)
+
+    def test_exact_uri_only(self):
+        validate_uri([URI])
+        for args in ([], ['majvaj-account:open?token=synthetic'], ['majvaj-account:open#x'],
+                     ['majvaj-account://open'], [URI, 'another-session'], ['https://localhost/'],
+                     ['majvaj-account:OPEN'], ['majvaj-account:open%20']):
+            with self.assertRaises(ValueError): self.run_handoff(args)
+        self.snapshot.assert_not_called();self.ask.assert_not_called();self.end.assert_not_called()
+
+    def test_explicit_confirmation_own_session(self):
+        self.assertTrue(self.run_handoff());self.end.assert_called_once_with('c42')
+        self.assertGreaterEqual(self.check.call_count,4)
+
+    def test_cancel_never_terminates(self):
+        self.ask.return_value=False
+        self.assertFalse(self.run_handoff());self.end.assert_not_called()
+
+    def test_no_active_session_refused_before_prompt(self):
+        self.snapshot.side_effect=ValueError('local session unavailable')
+        with self.assertRaises(ValueError):self.run_handoff()
+        self.ask.assert_not_called();self.end.assert_not_called()
+
+    def test_session_switch_after_confirmation(self):
+        self.ask.side_effect=lambda: (setattr(self.snapshot,'return_value',('new',':0','other',b'new')) or True)
+        with self.assertRaises(ValueError):self.run_handoff()
+        self.end.assert_not_called()
+
+    def test_same_session_changed_cookie_refused(self):
+        self.ask.side_effect=lambda: (setattr(self.snapshot,'return_value',self.initial[:3]+(b'replaced',)) or True)
+        with self.assertRaises(ValueError):self.run_handoff()
+        self.end.assert_not_called()
+
+    def test_lock_latched_even_if_snapshot_returns(self):
+        self.check.side_effect=[None,None,ValueError('locked')]
+        with self.assertRaises(ValueError):self.run_handoff()
+        self.end.assert_not_called()
+
+    def test_real_identity_rejects_root_or_wrong_uid(self):
+        with patch('credential_handoff.pwd.getpwnam',return_value=type('User',(),{'pw_uid':10001})()), patch('credential_handoff.os.getuid',return_value=0), patch('credential_handoff.os.geteuid',return_value=0):
+            with self.assertRaises(ValueError):identity()
+
+    def test_fixed_nonprivileged_terminate_command(self):
+        with patch('credential_handoff.subprocess.run') as run:
+            terminate('c42')
+            self.assertEqual(run.call_args.args[0],['/usr/bin/loginctl','terminate-session','c42'])
+            self.assertEqual(run.call_args.kwargs['env'],{'PATH':'/usr/bin:/bin','LC_ALL':'C'})
