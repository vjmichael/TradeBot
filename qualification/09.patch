+"""Dedicated local, qualification-only account enrollment; no web or venue adapter.
+
+The authenticated credential operator is the trusted writer. API keys exist only
+in the local masked entry process, the enrollment socket and isolated vault.
+"""
+import hashlib
+import os
+from pathlib import Path
+import pwd
+import socket
+import stat
+import subprocess
+
+from paper_credential_vault import checked_status, harden_process, send
+from reserve_checkpoint import require
+from reserve_ipc import protected_dir
+from reserve_review_launcher import _sessions, caller_session
+from reserve_review_session import read_source, select_cookie
+from reserve_review_events import SessionEvents
+
+OPERATOR = 'maj-vaj-credential-operator'
+MARKER = Path('/etc/maj-vaj/credential-desktop-enabled')
+ACCOUNTS = (
+    ('Kraken — read-only', (('kraken_read_key', 'Read-only API key'), ('kraken_read_secret', 'API secret'))),
+    ('Telegram — Desk bot', (('telegram_desk', 'Bot token'),)),
+    ('Telegram — Recovery bot', (('telegram_recovery', 'Bot token'),)),
+    ('Grok — optional', (('grok', 'API key'),)),
+)
+ACCOUNT_SLOTS = {name: tuple(slot for slot, _ in fields) for name, fields in ACCOUNTS}
+
+
+def current_identity():
+    user = pwd.getpwnam(OPERATOR)
+    uid = user.pw_uid
+    require(uid > 0 and os.geteuid() == os.getuid() == uid, 'credential_operator_required')
+    with protected_dir(MARKER.parent, 0, 0o755) as fd:
+        f = os.open(MARKER.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=fd)
+        try:
+            st = os.fstat(f)
+            require(stat.S_ISREG(st.st_mode) and st.st_uid == 0 and st.st_nlink == 1 and not st.st_mode & 0o022,
+                    'credential_desktop_disabled')
+        finally:
+            os.close(f)
+    session, display = _sessions(uid)
+    caller_session(session)
+    home = Path(user.pw_dir)
+    require(home.is_absolute() and home != Path('/'), 'credential_operator_home')
+    auth = home / '.Xauthority'
+    require(os.environ.get('DISPLAY') == display and
+            os.environ.get('XAUTHORITY', str(auth)) == str(auth), 'credential_display_contract')
+    cookie = select_cookie(read_source(home, uid), display, socket.gethostname().encode())
+    result = subprocess.run(['/usr/bin/xhost'], check=True, stdout=subprocess.PIPE,
+                            stderr=subprocess.DEVNULL, text=True, timeout=5,
+                            env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C', 'DISPLAY': display,
+                                 'XAUTHORITY': str(auth)})
+    require([line.strip() for line in result.stdout.splitlines() if line.strip()] ==
+            ['access control enabled, only authorized clients can connect'], 'credential_display_access_control')
+    require(_sessions(uid) == (session, display) and
+            select_cookie(read_source(home, uid), display, socket.gethostname().encode()) == cookie,
+            'credential_session_changed')
+    caller_session(session)
+    return session, display, str(auth), hashlib.sha256(cookie).digest()
+
+
+class AccountConnections:
+    """Small write-only controller with explicit intent and fixed error text.
+
+    A failed response may follow a completed write; never claim it was rolled back.
+    Refresh is the recovery path. Provider verification and revocation are absent.
+    """
+    def __init__(self, guard, request=send):
+        self.guard = guard
+        self.request = request
+
+    def _call(self, message):
+        self.guard()
+        return checked_status(self.request(message))
+
+    def status(self):
+        return self._call({'op': 'status'})
+
+    def save(self, account, values, confirmed):
+        if confirmed is not True or account not in ACCOUNT_SLOTS or set(values) != set(ACCOUNT_SLOTS[account]):
+            raise ValueError('credential selection refused')
+        if any(type(value) is not str or not 0 < len(value) <= 8192 or
+               any(c.isspace() or ord(c) < 33 or ord(c) == 127 for c in value) for value in values.values()):
+            raise ValueError('credential selection refused')
+        return self._call({'op': 'enroll', 'values': values})
+
+    def remove(self, account, confirmed):
+        if confirmed is not True or account not in ACCOUNT_SLOTS:
+            raise ValueError('credential selection refused')
+        return self._call({'op': 'remove', 'slots': list(ACCOUNT_SLOTS[account])})
+
+
+def window(root, controller, guard):
+    import tkinter as tk
+    from tkinter import ttk
+    root.title('Maj Vaj — Account connections')
+    root.geometry('680x450+30+30')
+    root.minsize(630, 420)
+    frame = ttk.Frame(root, padding=18)
+    frame.pack(fill='both', expand=True)
+    ttk.Label(frame, text='Account connections', font=('TkDefaultFont', 18)).pack(anchor='w')
+    ttk.Label(frame, text='PAPER qualification only. Use synthetic credentials. No connection test or trading is enabled.',
+              wraplength=600).pack(anchor='w', pady=(6, 12))
+    ttk.Label(frame, text='Account').pack(anchor='w')
+    account = tk.StringVar(value=ACCOUNTS[0][0])
+    chooser = ttk.Combobox(frame, textvariable=account, values=[a for a, _ in ACCOUNTS], state='readonly')
+    chooser.pack(fill='x')
+    status = tk.StringVar(value='Checking local storage…')
+    ttk.Label(frame, textvariable=status, wraplength=600).pack(anchor='w', pady=6)
+    fields_frame = ttk.Frame(frame)
+    fields_frame.pack(fill='x')
+    entries = {}
+    confirmed = tk.BooleanVar(value=False)
+    notice = tk.StringVar(value='')
+
+    def clear():
+        for entry in entries.values():
+            entry.delete(0, 'end')
+        confirmed.set(False)
+
+    def show(presence):
+        labels = {'stored_unverified': 'Saved locally · not verified', 'not_configured': 'Not configured'}
+        status.set(labels[presence[ACCOUNT_SLOTS[account.get()][0]]])
+
+    def refresh():
+        clear()
+        try:
+            show(controller.status())
+            notice.set('')
+        except Exception:
+            status.set('Storage unavailable')
+            notice.set('Could not confirm stored status. No connection has been verified.')
+
+    def rebuild(*_):
+        clear()
+        for child in fields_frame.winfo_children():
+            child.destroy()
+        entries.clear()
+        for name, fields in ACCOUNTS:
+            if name != account.get():
+                continue
+            for slot, label in fields:
+                ttk.Label(fields_frame, text=label).pack(anchor='w')
+                entry = ttk.Entry(fields_frame, show='*', exportselection=False)
+                # No copying/cutting secrets into the system clipboard.
+                for sequence in ('<<Copy>>', '<<Cut>>', '<Control-c>', '<Control-x>', '<Control-Insert>', '<Shift-Delete>'):
+                    entry.bind(sequence, lambda _e: 'break')
+                entry.pack(fill='x', pady=(0, 5))
+                entries[slot] = entry
+        refresh()
+
+    def submit(remove=False):
+        yes = confirmed.get()
+        values = {} if remove else {slot: entry.get() for slot, entry in entries.items()}
+        clear()  # Never leave submitted secrets visible or available to another action.
+        try:
+            result = controller.remove(account.get(), yes) if remove else controller.save(account.get(), values, yes)
+            show(result)
+            notice.set('Removed locally. Revoke the key at its provider separately.' if remove else 'Saved locally. Connection not verified; trading stays disabled.')
+        except Exception:
+            status.set('Refresh to verify status')
+            notice.set('Change not confirmed. Review local status before retrying.')
+        finally:
+            values.clear()  # Python/Tk do not guarantee memory erasure.
+
+    chooser.bind('<<ComboboxSelected>>', rebuild)
+    ttk.Checkbutton(frame, text='I confirm this local test credential change.', variable=confirmed).pack(anchor='w', pady=8)
+    buttons = ttk.Frame(frame)
+    buttons.pack(fill='x')
+    ttk.Button(buttons, text='Save / replace', command=submit).pack(side='left', padx=(0, 8))
+    ttk.Button(buttons, text='Remove locally', command=lambda: submit(True)).pack(side='left', padx=(0, 8))
+    ttk.Button(buttons, text='Refresh', command=refresh).pack(side='left')
+    ttk.Label(frame, textvariable=notice, wraplength=600).pack(anchor='w', pady=8)
+    ttk.Label(frame, text='Kraken trading keys, Telegram pairing and provider verification are not available yet.', wraplength=600).pack(anchor='w')
+    timer = None
+    def close():
+        if timer is not None:
+            root.after_cancel(timer)
+        clear()
+        root.destroy()
+    ttk.Button(frame, text='End account session', command=close).pack(anchor='e', pady=6)
+    root.protocol('WM_DELETE_WINDOW', close)
+    def recheck():
+        nonlocal timer
+        timer = None
+        try:
+            guard()
+        except Exception:
+            close()
+            return
+        timer = root.after(500, recheck)
+    rebuild()
+    timer = root.after(500, recheck)
+    return {'entries': entries, 'account': account, 'confirmed': confirmed,
+            'rebuild': rebuild, 'submit': submit, 'notice': notice, 'status': status, 'close': close}
+
+
+def run():
+    harden_process()
+    os.umask(0o077)
+    identity = current_identity()
+    os.environ['DISPLAY'], os.environ['XAUTHORITY'] = identity[1:3]
+    with SessionEvents(identity[0]) as events:
+        def guard():
+            events.check()
+            require(current_identity() == identity, 'credential_session_changed')
+            events.check()
+        guard()
+        import tkinter as tk
+        root = tk.Tk()
+        # Fixed status only for unexpected Tk callback exceptions; do not print traceback.
+        root.report_callback_exception = lambda *_: root.destroy()
+        window(root, AccountConnections(guard), guard)
+        root.mainloop()
+
+
+def main():
+    try:
+        run()
+    except Exception:
+        raise SystemExit('Local account connections session unavailable.') from None
+
+
+if __name__ == '__main__':
+    main()
