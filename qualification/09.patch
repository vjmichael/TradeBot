+#!/bin/bash
+# Explicit administrator operation only; no secret access, account mutation or service activation.
+set -euo pipefail
+[[ $# == 1 && ( $1 == --check || $1 == --install ) ]] || exit 2
+[[ $EUID == 0 && $(cat /proc/1/comm) == systemd ]] || exit 1
+cd /opt/maj-vaj
+for p in lightdm lightdm-gtk-greeter xserver-xorg-core x11-xserver-utils xauth libpam-systemd libsystemd0; do
+ [[ $(dpkg-query -W -f='${db:Status-Abbrev}' "$p" 2>/dev/null || :) == 'ii ' ]] || { echo "Missing installed package: $p" >&2; exit 1; }
+done
+venv/bin/python -I -B - <<'PY'
+import os,pwd,grp,stat,tkinter
+from pathlib import Path
+names=('maj-vaj-credential-operator','maj-vaj-vault','maj-vaj','maj-vaj-dashboard-auth','maj-vaj-approval','maj-vaj-native')
+users=[pwd.getpwnam(n) for n in names]
+p=users[0]
+assert all(u.pw_uid>0 for u in users) and len({u.pw_uid for u in users})==len(users)
+assert p.pw_gid==grp.getgrnam(p.pw_name).gr_gid
+# No other primary/supplementary members of credential operator group.
+assert all(u.pw_gid!=p.pw_gid or u.pw_name==p.pw_name for u in pwd.getpwall())
+assert set(grp.getgrnam(p.pw_name).gr_mem) <= {p.pw_name,'maj-vaj-vault'}
+home=Path(p.pw_dir);st=home.lstat()
+assert home.is_absolute() and home!=Path('/') and stat.S_ISDIR(st.st_mode) and st.st_uid==p.pw_uid and stat.S_IMODE(st.st_mode)==0o700
+assert p.pw_shell not in ('/usr/sbin/nologin','/sbin/nologin','/bin/false') and os.access(p.pw_shell,os.X_OK)
+for n in ('.','credential_graphical.py','paper_credential_vault.py','scripts','scripts/credential_session_wrapper.sh','scripts/review_session_wrapper.sh','deploy','deploy/maj-vaj-account-connections.desktop'):
+ s=Path(n).lstat();assert s.st_uid==0 and not s.st_mode&0o022 and not stat.S_ISLNK(s.st_mode)
+assert os.access('scripts/credential_session_wrapper.sh',os.X_OK)
+print('Dedicated credential identity and source preflight passed.')
+PY
+[[ $1 == --install ]] || exit 0
+dest=/usr/share/xsessions/maj-vaj-account-connections.desktop
+if [[ -e $dest || -L $dest ]];then
+ [[ ! -L $dest && -f $dest && $(stat -c '%u:%a' "$dest") == 0:644 ]] && cmp -s deploy/maj-vaj-account-connections.desktop "$dest" || exit 1
+else
+ install -o root -g root -m644 deploy/maj-vaj-account-connections.desktop "$dest"
+fi
+echo 'Installed session entry only. Review LightDM configuration and activate the dedicated marker separately.'
