+"""Synthetic local account management; never contact a real provider."""
+import json
+import gc
+import os
+from pathlib import Path
+import tempfile
+import threading
+import unittest
+from unittest.mock import patch
+from cryptography.fernet import Fernet
+from fastapi.testclient import TestClient
+from credential_graphical import AccountConnections, ACCOUNTS, window
+from paper_credential_vault import PaperVault, dispatch, Server, send, checked_status
+from tradebot import create_app
+
+
+class GraphicalCredentialTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.path = Path(self.temp.name)
+        self.vault = PaperVault(self.path, Fernet.generate_key())
+        self.calls = []
+        self.valid = True
+        def guard():
+            if not self.valid:
+                raise PermissionError('lost session')
+        def request(req):
+            self.calls.append(req['op'])
+            return dispatch(self.vault, req)
+        self.guard = guard
+        self.manager = AccountConnections(guard, request)
+
+    def test_save_pair_atomic_replace_remove(self):
+        name = ACCOUNTS[0][0]
+        values = {'kraken_read_key':'synthetic-a', 'kraken_read_secret':'synthetic-b'}
+        self.assertFalse(any(s=='stored_unverified' for s in self.manager.status().values()))
+        self.assertEqual(self.manager.save(name,values,True)['kraken_read_key'],'stored_unverified')
+        self.assertEqual(self.manager.save(name,{k:v+'2' for k,v in values.items()}, True)['kraken_read_secret'],'stored_unverified')
+        self.assertEqual(self.manager.remove(name,True)['kraken_read_key'],'not_configured')
+        for f in self.path.glob('vault.sqlite3*'):
+            for v in values.values():
+                self.assertNotIn(v.encode(),f.read_bytes())
+
+    def test_role_selection_confirmation_and_partial_pair_refused(self):
+        for label,values,ok in ((ACCOUNTS[0][0],{'kraken_read_key':'synthetic'},True),
+                                (ACCOUNTS[1][0],{'telegram_recovery':'synthetic'},True),
+                                (ACCOUNTS[3][0],{'grok':'synthetic'},False),
+                                ('Trading',{'kraken_trade_key':'synthetic'},True),
+                                (ACCOUNTS[3][0],{'grok':'with space'},True)):
+            with self.assertRaises(ValueError):self.manager.save(label,values,ok)
+        with self.assertRaises(ValueError):self.manager.remove(ACCOUNTS[1][0],False)
+        self.assertEqual(self.calls,[])
+
+    def test_invalidated_session_never_writes(self):
+        self.valid=False
+        for f in (lambda:self.manager.save(ACCOUNTS[3][0],{'grok':'synthetic'},True),
+                  lambda:self.manager.remove(ACCOUNTS[3][0],True),self.manager.status):
+            with self.assertRaises(PermissionError):f()
+        self.assertEqual(self.calls,[])
+
+    def test_status_schema_rejects_secret_or_inconsistent_pair(self):
+        valid=self.vault.status()
+        self.assertEqual(checked_status(valid),valid['credentials'])
+        for mutation in ({'extra':'synthetic'}, {'credentials':dict(valid['credentials'],grok='synthetic')},
+                         {'credentials':dict(valid['credentials'],kraken_read_key='stored_unverified')},
+                         {'connections_verified':True}):
+            with self.assertRaises(ValueError):checked_status(valid|mutation)
+
+    def test_status_socket_only_allows_status(self):
+        path=self.path/'status.sock'
+        server=Server(path,self.vault,os.getuid(),read_only=True)
+        worker=threading.Thread(target=server.serve_forever,daemon=True);worker.start()
+        try:
+            self.assertTrue(send({'op':'status'},path,os.getuid())['ok'])
+            for req in ({'op':'enroll','values':{'grok':'synthetic'}},{'op':'remove','slots':['grok']},
+                        {'op':'status','extra':'synthetic'},{'op':'read','slot':'grok'}):
+                self.assertFalse(send(req,path,os.getuid())['ok'])
+            server.operator_uid=os.getuid()+1
+            self.assertFalse(send({'op':'status'},path,os.getuid())['ok'])
+        finally:
+            server.shutdown();worker.join();server.server_close()
+        self.assertEqual(self.vault.status()['credentials']['grok'],'not_configured')
+
+    def test_private_dashboard_reports_presence_only_and_no_write(self):
+        self.vault.enroll({'grok':'synthetic-dashboard-canary'})
+        with patch('paper_credential_vault.dashboard_status',return_value=checked_status(self.vault.status())):
+            with TestClient(create_app(self.path/'desk',None,_private_backend=True),base_url='http://127.0.0.1') as client:
+                r=client.get('/api/setup');self.assertEqual(r.status_code,200)
+                self.assertEqual(r.json()['enrollment_mode'],'dedicated_local_window')
+                self.assertEqual(r.json()['credentials']['grok'],'stored_unverified')
+                self.assertNotIn('synthetic-dashboard-canary',r.text)
+                self.assertFalse(r.json()['deployment_ready'])
+                self.assertEqual(client.post('/api/setup/credentials',json={'grok':'synthetic-write'}).status_code,503)
+                with patch('paper_credential_vault.dashboard_status',side_effect=ValueError('synthetic-failure')):
+                    failure=client.get('/api/setup').json();self.assertFalse(failure['vault_available'])
+                    self.assertTrue(all(v=='unavailable' for v in failure['credentials'].values()))
+                    self.assertNotIn('synthetic-failure',json.dumps(failure))
+
+    def test_tk_actual_masked_widgets_cancel_save_and_remove(self):
+        import tkinter as tk
+        root=tk.Tk(); root.withdraw()
+        try:
+            controls=window(root,self.manager,self.guard)
+            entries=controls['entries']
+            self.assertEqual(set(entries),{'kraken_read_key','kraken_read_secret'})
+            for entry in entries.values():
+                self.assertEqual(entry.cget('show'),'*');entry.insert(0,'synthetic-gui-1')
+            controls['submit']() # no confirmation
+            self.assertTrue(all(e.get()=='' for e in entries.values()))
+            self.assertEqual(self.vault.status()['credentials']['kraken_read_key'],'not_configured')
+            for entry in entries.values():entry.insert(0,'synthetic-gui-2')
+            controls['confirmed'].set(True);controls['submit']()
+            self.assertTrue(all(e.get()=='' for e in entries.values()))
+            self.assertIn('Saved locally',controls['notice'].get())
+            self.assertEqual(self.vault.status()['credentials']['kraken_read_key'],'stored_unverified')
+            controls['confirmed'].set(True);controls['submit'](True)
+            self.assertIn('Revoke the key at its provider separately',controls['notice'].get())
+            self.assertEqual(self.vault.status()['credentials']['kraken_read_key'],'not_configured')
+            controls['account'].set(ACCOUNTS[2][0]);controls['rebuild']()
+            self.assertEqual(set(entries),{'telegram_recovery'})
+            entries['telegram_recovery'].insert(0,'synthetic-cancel')
+            controls['close']();root=None
+            self.assertEqual(self.vault.status()['credentials']['telegram_recovery'],'not_configured')
+        finally:
+            if root is not None:root.destroy()
+            # Collect Tk callback cycles on the creating thread before later worker tests.
+            controls = entries = entry = root = None
+            gc.collect()
+
+
+if __name__=='__main__':unittest.main()
