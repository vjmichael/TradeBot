[Unit]
Description=Maj Vaj PAPER reserve checkpoint authority (staged, not enabled)

[Service]
Type=simple
User=maj-vaj-approval
Group=maj-vaj-approval
WorkingDirectory=/opt/maj-vaj
ExecStart=/opt/maj-vaj/venv/bin/python -m reserve_recovery --authority-user maj-vaj-approval --desk-user maj-vaj --workspace installed-paper --witness /var/lib/maj-vaj-reserve-authority --socket-dir /run/maj-vaj-reserve-authority --pin /etc/maj-vaj/reserve-checkpoint.pub --native-pin /etc/maj-vaj/reserve-native.pub
RuntimeDirectory=maj-vaj-reserve-authority
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/maj-vaj-reserve-authority
InaccessiblePaths=-/var/lib/maj-vaj -/var/lib/maj-vaj-reserve-approval
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=3s
TimeoutStopSec=5s
KillMode=control-group
