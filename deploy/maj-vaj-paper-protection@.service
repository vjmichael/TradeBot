[Unit]
Description=Maj Vaj recovery-only paper protection (%i)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/maj-vaj/data/paper/%i/paper.sqlite

[Service]
Type=notify
NotifyAccess=main
User=maj-vaj
Group=maj-vaj
WorkingDirectory=/opt/maj-vaj
ExecStart=/opt/maj-vaj/venv/bin/python /opt/maj-vaj/scripts/run_paper_worker.py /var/lib/maj-vaj/data %i
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=15s
WatchdogSec=60s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/maj-vaj/data
InaccessiblePaths=-/var/lib/maj-vaj/approval
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=2G
TasksMax=128

[Install]
WantedBy=multi-user.target
