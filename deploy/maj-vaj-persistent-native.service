[Unit]
Description=Maj Vaj supervised warm PAPER runtime (staged)
ConditionPathExists=/etc/maj-vaj/persistent-native-enabled
ConditionPathExists=/etc/maj-vaj/protected-entry-enabled
ConditionPathExists=/etc/maj-vaj/protected-exit-enabled
ConditionPathExists=/etc/maj-vaj/reserve-transport-enabled
ConditionPathExists=/etc/maj-vaj/entry-fence.lock
Wants=maj-vaj-entry-desk.service network-online.target
After=maj-vaj-entry-desk.service maj-vaj-reserve-relay.service network-online.target

[Service]
Type=notify
NotifyAccess=main
User=maj-vaj-native
Group=maj-vaj-native
SupplementaryGroups=maj-vaj-transfer
WorkingDirectory=/opt/maj-vaj
ExecStart=/opt/maj-vaj/venv/bin/python -I -B -c 'import sys;sys.path.insert(0,"/opt/maj-vaj");from reserve_persistent_worker import main;main()'
TimeoutStartSec=120s
WatchdogSec=30s
TimeoutStopSec=5s
Restart=on-failure
RestartSec=3s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/maj-vaj-native /var/lib/maj-vaj-terminal-outbox
InaccessiblePaths=-/var/lib/maj-vaj -/var/lib/maj-vaj-reserve-approval -/var/lib/maj-vaj-reserve-relay
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
MemoryMax=2G
TasksMax=128
StandardOutput=null
StandardError=null
